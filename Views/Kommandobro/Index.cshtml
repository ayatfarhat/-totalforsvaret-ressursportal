@using System.Text.Json
@model Nabohjelp.Models.MapViewModel

@{
    ViewData["Title"] = "Oversikt";
    Layout = "_KommandobroLayout";
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="kb-topp">
    <div>
        <h1>Oversikt</h1>
        <p>Behov og ressurser akkurat nå.</p>
    </div>
    <div class="kb-handlinger">
        <a class="btn btn-lys" asp-controller="Behov" asp-action="Ko">Åpne behovskø</a>
        <a class="btn btn-omriss" asp-controller="Tildeling" asp-action="Index">Tildel ressurser</a>
    </div>
</div>

<div class="kb-tall">
    <div class="kort-kommandobro tall-behov">
        <strong>@Model.Behov.Count</strong>
        <span>Registrerte behov</span>
    </div>
    <div class="kort-kommandobro tall-ressurs">
        <strong>@Model.Ressurser.Count</strong>
        <span>Ressurser på kartet</span>
    </div>
</div>

<section class="kort-kommandobro kb-kartkort" aria-labelledby="kart-tittel">
    <div class="kb-kartkort-topp">
        <h2 id="kart-tittel">Kart</h2>
        <ul class="kb-tegnforklaring">
            <li><i style="background:#E5522C"></i>Behov</li>
            <li><i style="background:#1B6B4B"></i>Ressurs</li>
        </ul>
    </div>
    <div id="oversiktsKart" role="group" aria-label="Kart over behov og ressurser"></div>
    @if (!Model.Behov.Any() && !Model.Ressurser.Any())
    {
        <p class="kb-kartstatus">Ingen behov eller ressurser med posisjon er registrert ennå.</p>
    }
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/kart.js" asp-append-version="true"></script>
    <script>
        // Punktene sendes fra controlleren som JSON, ferdig klare til bruk her.
        visOversikt(
            'oversiktsKart',
            @Html.Raw(JsonSerializer.Serialize(Model.Ressurser)),
            @Html.Raw(JsonSerializer.Serialize(Model.Behov))
        );
    </script>
}
