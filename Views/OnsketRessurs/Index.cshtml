@model List<Nabohjelp.Models.OnsketRessurs>

@{
    ViewData["Title"] = "Ønskede ressurser";
    bool kanAdministrere = User.IsInRole("Admin") || User.IsInRole("Kommune");
}

<div class="side-topp">
    <h1>Ønskede ressurser</h1>
    <p class="ingress">Dette er ressursene kommunen og kriseledelsen trenger akkurat nå. Har du noe på lista? Registrer det, så kan det kobles til et behov.</p>
</div>

@if (kanAdministrere)
{
    <p><a asp-action="Create" class="btn btn-success">Legg til ønsket ressurs</a></p>
}

@if (!Model.Any())
{
    <div class="tom-tilstand">
        <h2 class="h3">Ingen ønskede ressurser akkurat nå</h2>
        <p>Du kan likevel registrere det du kan stille med. Kriseledelsen ser det.</p>
        <a class="btn btn-success" asp-controller="Ressurs" asp-action="Create">Registrer en ressurs</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table stablet align-middle">
            <thead>
                <tr>
                    <th scope="col">Type</th>
                    <th scope="col">Antall</th>
                    <th scope="col">Sted</th>
                    <th scope="col">Beskrivelse</th>
                    <th scope="col"><span class="visually-hidden">Handling</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var onsket in Model)
                {
                    <tr>
                        <td data-label="Type"><strong>@onsket.Type</strong></td>
                        <td data-label="Antall">@onsket.Antall</td>
                        <td data-label="Sted">@onsket.Sted</td>
                        <td data-label="Beskrivelse">@onsket.VisBeskrivelse()</td>
                        <td data-label="">
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-success btn-sm" asp-controller="Ressurs" asp-action="Create" asp-route-type="@onsket.Type">Jeg kan stille med dette</a>
                                @if (kanAdministrere)
                                {
                                    <form asp-action="Fjern" asp-route-id="@onsket.Id" method="post">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Fjern</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
