@model Nabohjelp.Models.OnsketRessurs

@{
    ViewData["Title"] = T["Legg til ønsket ressurs"];
}

<div class="side-topp">
    <h1>@T["Legg til ønsket ressurs"]</h1>
    <p class="ingress">@T["Fortell hva dere trenger. Innbyggerne ser lista i BeredskapsPortalen og kan registrere akkurat dette."]</p>
</div>

<form asp-action="Create" method="post" class="skjema" novalidate>
    <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>

    <fieldset class="felt-gruppe">
        <legend>@T["Hva trenger dere?"]</legend>
        <div class="type-valg" role="presentation">
            @{ var typer = RessursFormViewModel.Typer; }
            @for (var i = 0; i < typer.Count; i++)
            {
                <div class="type-valg-element">
                    <input type="radio" asp-for="Type" value="@typer[i]" id="type-@i" />
                    @* Usynlig mellomrom etter «/» lar lange navn brytes pent på mobil *@
                        <label for="type-@i">@T[typer[i]].Value.Replace("/", "/\u200B")</label>
                </div>
            }
        </div>
        <span asp-validation-for="Type"></span>
    </fieldset>

    <fieldset class="felt-gruppe">
        <legend>@T["Hvor mange, og hvor?"]</legend>
        <div class="felt-par">
            <div class="felt">
                <label asp-for="Antall" class="form-label">@T["Antall"]</label>
                <input asp-for="Antall" class="form-control" type="number" min="1" max="999" inputmode="numeric" />
                <span asp-validation-for="Antall"></span>
            </div>
            <div class="felt">
                <label asp-for="Sted" class="form-label">@T["Sted"]</label>
                <input asp-for="Sted" class="form-control" placeholder="@T["For eksempel Grimstad sentrum"]" />
                <span asp-validation-for="Sted"></span>
            </div>
        </div>
        <div class="felt">
            <label asp-for="Beskrivelse" class="form-label">@T["Beskrivelse"] <span class="valgfritt">@T["(valgfritt)"]</span></label>
            <textarea asp-for="Beskrivelse" class="form-control" rows="3" placeholder="@T["For eksempel hvor lenge dere trenger den"]"></textarea>
            <span asp-validation-for="Beskrivelse"></span>
        </div>
    </fieldset>

    <div class="skjema-bunn">
        <button type="submit" class="btn btn-success btn-lg">@T["Legg til"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">@T["Avbryt"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
