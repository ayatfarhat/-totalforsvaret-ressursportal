@model Nabohjelp.ViewModels.BehovViewModel
@{
    // Samme skjema brukes for å melde et nytt behov (Id = 0) og for å endre et behov.
    bool erNy = Model.Id == 0;
    bool erKoordinator = Tilgang.ErAnsatt(User);
    ViewData["Title"] = erNy ? "Meld behov" : "Endre behov";
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="side-topp">
    @if (erNy)
    {
        <h1>@T["Meld behov"]</h1>
        <p class="ingress">@T["Fortell hva du trenger og hvor du er. Kriseledelsen ser meldingen med en gang."]</p>
    }
    else
    {
        <h1>@T["Endre behov"]</h1>
        <p class="ingress">@T["Rett opp det som har endret seg. Kriseledelsen ser endringen med en gang."]</p>
    }
    <p class="felt-hjelp">@T["Felter merket med * er obligatoriske."]</p>
</div>

<div class="skjema-rutenett">
    <form asp-action="@(erNy ? "Opprett" : "Rediger")" asp-route-id="@(erNy ? "" : Model.Id.ToString())" method="post" class="skjema" novalidate>
        <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">1</span> Hva trenger du? *</legend>
            <div class="type-valg type-valg-hjelp">
                @foreach (var type in Enum.GetValues<BehovType>())
                {
                    <div class="type-valg-element">
                        <input type="radio" asp-for="Type" value="@type" id="type-@type" data-forslag="@BehovViewModel.HentForslag(type)" />
                        <label for="type-@type">@Visningstekst.Type(type)</label>
                    </div>
                }
            </div>
            <span asp-validation-for="Type"></span>

            <div class="felt mt-3" id="annet-felt" hidden>
                <label asp-for="AnnetType" class="form-label">Hva slags behov? *</label>
                <input asp-for="AnnetType" class="form-control" placeholder="Hva slags behov? Eksempel: vannlekkasje, steinras, snømåking" />
                <span asp-validation-for="AnnetType"></span>
            </div>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">2</span> Hvor haster det? *</legend>
            <div class="type-valg type-valg-hjelp type-valg-bred">
                <div class="type-valg-element">
                    <input type="radio" asp-for="Prioritet" value="@BehovPrioritet.Urgent" id="prioritet-akutt" />
                    <label for="prioritet-akutt"><span><strong>Akutt</strong><small>Trenger hjelp nå</small></span></label>
                </div>
                <div class="type-valg-element">
                    <input type="radio" asp-for="Prioritet" value="@BehovPrioritet.Planned" id="prioritet-planlagt" />
                    <label for="prioritet-planlagt"><span><strong>Planlagt</strong><small>Kan vente</small></span></label>
                </div>
            </div>
            <span asp-validation-for="Prioritet"></span>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">3</span> Hvor er du?</legend>

            <div id="behovKart" class="kart-boks kart-lav"
                 data-kartvelger
                 data-bredde="#Latitude"
                 data-lengde="#Longitude"
                 data-status="#valgtPosisjon"
                 data-knapp="#minPosisjon"
                 data-nal="hjelp"
                 role="group"
                 aria-label="Kart. Trykk for å velge posisjon."></div>
            <div class="kart-rad">
                <button type="button" id="minPosisjon" class="btn btn-outline-secondary btn-sm">Bruk min posisjon</button>
                <p id="valgtPosisjon" class="valgt" aria-live="polite">Ingen posisjon valgt ennå.</p>
            </div>
            <p class="kart-tips">Trykk på kartet, bruk posisjonen din, eller skriv inn koordinatene under.</p>

            <div class="felt-par mt-3">
                <div class="felt">
                    <label asp-for="Latitude" class="form-label">Breddegrad *</label>
                    <input asp-for="Latitude" class="form-control" inputmode="decimal" placeholder="58.14656" />
                    <span asp-validation-for="Latitude"></span>
                </div>
                <div class="felt">
                    <label asp-for="Longitude" class="form-label">Lengdegrad *</label>
                    <input asp-for="Longitude" class="form-control" inputmode="decimal" placeholder="7.99560" />
                    <span asp-validation-for="Longitude"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">4</span> Fortell mer og hvordan vi når deg</legend>

            <div class="felt">
                <label asp-for="Beskrivelse" class="form-label">Beskrivelse</label>
                <textarea asp-for="Beskrivelse" class="form-control" rows="4" placeholder="For eksempel hvor mange personer det gjelder, eller hva som har skjedd"></textarea>
                <span asp-validation-for="Beskrivelse"></span>
                <p class="kart-tips">Når du velger behovstype, fyller vi inn noen spørsmål du kan svare på. Du kan endre teksten fritt.</p>
            </div>

            <p class="felt-hjelp">Oppgi telefon eller e-post, minst én av dem.</p>
            <div class="felt-par">
                <div class="felt">
                    <label asp-for="KontaktTelefon" class="form-label">Telefon</label>
                    <div class="telefon-rad">
                        <select asp-for="Landskode" class="form-select" aria-label="Landskode">
                            @foreach (var land in RessursFormViewModel.Landskoder)
                            {
                                <option value="@land.Kode">@land.Kode @land.Land</option>
                            }
                        </select>
                        <input asp-for="KontaktTelefon" class="form-control" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="12345678" />
                    </div>
                    <span asp-validation-for="Landskode"></span>
                    <span asp-validation-for="KontaktTelefon"></span>
                </div>
                <div class="felt">
                    <label asp-for="KontaktEpost" class="form-label">E-post</label>
                    <input asp-for="KontaktEpost" class="form-control" type="email" autocomplete="email" />
                    <span asp-validation-for="KontaktEpost"></span>
                    @if (!string.IsNullOrEmpty(Model.KontaktEpost) && Model.KontaktEpost == User.Identity?.Name)
                    {
                        <p class="kart-tips">Hentet fra kontoen din. Du kan endre den.</p>
                    }
                </div>
            </div>
        </fieldset>

        <div class="skjema-bunn">
            <button type="submit" class="btn btn-danger btn-lg">@(erNy ? "Send inn" : "Lagre endringer")</button>
            @if (erNy)
            {
                <a asp-controller="Ressurs" asp-action="Index" class="btn btn-outline-secondary btn-lg">Avbryt</a>
            }
            else
            {
                <a asp-action="@(erKoordinator ? "Ko" : "MineBehov")" class="btn btn-outline-secondary btn-lg">Avbryt</a>
            }
        </div>
    </form>

    <aside class="sidepanel sidepanel-nod" aria-labelledby="panel-tittel">
        <h2 id="panel-tittel">Er det fare for liv?</h2>
        <p class="nod-tall">
            <a href="tel:110">110 Brann</a>
            <a href="tel:112">112 Politi</a>
            <a href="tel:113">113 Ambulanse</a>
        </p>
        <p>Ring først. BeredskapsPortalen er ikke en nødtjeneste, og du får ikke svar umiddelbart.</p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/kart.js" asp-append-version="true"></script>
    <script src="~/js/ressurs-skjema.js" asp-append-version="true"></script>

    @* Viser feltet for fritekst bare når behovstypen «Annet» er valgt. *@
    <script>
        (function () {
            const felt = document.getElementById("annet-felt");
            const radioer = document.querySelectorAll('input[name="Type"]');

            function oppdater() {
                const valgt = document.querySelector('input[name="Type"]:checked');
                felt.hidden = !valgt || valgt.value !== "Annet";
            }

            radioer.forEach(radio => radio.addEventListener('change', oppdater));
            oppdater();
        })();
    </script>
}
