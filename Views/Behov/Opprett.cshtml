@model Nabohjelp.ViewModels.BehovViewModel
@{
    // Samme skjema brukes for å melde et nytt behov (Id = 0) og for å endre et behov.
    bool erNy = Model.Id == 0;
    bool erKoordinator = Tilgang.ErAnsatt(User);
    ViewData["Title"] = erNy ? T["Meld behov"] : T["Endre behov"];
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
}

<div class="side-topp">
    @if (erNy)
    {
        <h1>@T["Meld behov"]</h1>
        <p class="ingress">@T["Fortell hva du trenger og hvor du er. Kriseledelsen ser meldingen med en gang."]</p>
    }
    else
    {
        <h1>@T["Endre behov"]</h1>
        <p class="ingress">@T["Rett opp det som har endret seg. Kriseledelsen ser endringen med en gang."]</p>
    }
    <p class="felt-hjelp">@T["Felter merket med * er obligatoriske."]</p>
</div>

<div class="skjema-rutenett">
    <form asp-action="@(erNy ? "Opprett" : "Rediger")" asp-route-id="@(erNy ? "" : Model.Id.ToString())" method="post" class="skjema" novalidate>
        <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>
        <partial name="_Honningkrukke" />

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">1</span> @T["Hva trenger du? *"]</legend>
            <div class="type-valg type-valg-hjelp">
                @foreach (var type in Enum.GetValues<BehovType>())
                {
                    <div class="type-valg-element">
                        <input type="radio" asp-for="Type" value="@type" id="type-@type" data-forslag="@BehovViewModel.HentForslag(type)" />
                        <label for="type-@type">@Visningstekst.Type(type)</label>
                    </div>
                }
            </div>
            <span asp-validation-for="Type"></span>

            <div class="felt mt-3" id="annet-felt" hidden>
                <label asp-for="AnnetType" class="form-label">@T["Hva slags behov? *"]</label>
                <input asp-for="AnnetType" class="form-control" placeholder="@T["Hva slags behov? Eksempel: vannlekkasje, steinras, snømåking"]" />
                <span asp-validation-for="AnnetType"></span>
            </div>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">2</span> @T["Hvor haster det? *"]</legend>
            <div class="type-valg type-valg-hjelp type-valg-bred">
                <div class="type-valg-element">
                    <input type="radio" asp-for="Prioritet" value="@BehovPrioritet.Urgent" id="prioritet-akutt" />
                    <label for="prioritet-akutt"><span><strong>@T["Akutt"]</strong><small>@T["Trenger hjelp nå"]</small></span></label>
                </div>
                <div class="type-valg-element">
                    <input type="radio" asp-for="Prioritet" value="@BehovPrioritet.Planned" id="prioritet-planlagt" />
                    <label for="prioritet-planlagt"><span><strong>@T["Planlagt"]</strong><small>@T["Kan vente"]</small></span></label>
                </div>
            </div>
            <span asp-validation-for="Prioritet"></span>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">3</span> @T["Hvor er du?"]</legend>

            <div id="behovKart" class="kart-boks kart-lav"
                 data-kartvelger
                 data-bredde="#Latitude"
                 data-lengde="#Longitude"
                 data-status="#valgtPosisjon"
                 data-knapp="#minPosisjon"
                 data-kommune="#KommuneNavn"
                 data-nal="hjelp"
                 role="group"
                 aria-label="@T["Kart. Trykk for å velge posisjon."]"></div>
            <div class="kart-rad">
                <button type="button" id="minPosisjon" class="btn btn-outline-secondary btn-sm">@T["Bruk min posisjon"]</button>
                <p id="valgtPosisjon" class="valgt" aria-live="polite">@T["Ingen posisjon valgt ennå."]</p>
            </div>
            <p class="kart-tips">@T["Trykk på kartet eller bruk posisjonen din. Da fyller vi inn kommunen."]</p>

            <div class="felt mt-3">
                <label asp-for="KommuneNavn" class="form-label">@T["Kommune"] <span class="valgfritt">@T["(fylles inn fra kartet, eller skriv selv)"]</span></label>
                <input asp-for="KommuneNavn" class="form-control" list="kommuneliste" autocomplete="off" placeholder="@T["For eksempel Grimstad"]" />
                <partial name="_Kommuneliste" />
                <span asp-validation-for="KommuneNavn"></span>
            </div>

            @* Koordinatene fylles inn av kartet. Den som ikke kan bruke kartet, kan skrive dem selv.
               Boksen er åpen hvis koordinatene mangler eller er feil, så feilmeldingen synes. *@
            @{
                var ugyldig = Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid;
                bool koordinatFeil = ViewData.ModelState.GetFieldValidationState("Latitude") == ugyldig
                    || ViewData.ModelState.GetFieldValidationState("Longitude") == ugyldig;
            }
            <details class="koordinater" open="@koordinatFeil">
                <summary>@T["Skriv inn koordinater selv"]</summary>
                <div class="felt-par mt-2">
                    <div class="felt">
                        <label asp-for="Latitude" class="form-label">@T["Breddegrad *"]</label>
                        <input asp-for="Latitude" class="form-control" inputmode="decimal" placeholder="58.14656" />
                        <span asp-validation-for="Latitude"></span>
                    </div>
                    <div class="felt">
                        <label asp-for="Longitude" class="form-label">@T["Lengdegrad *"]</label>
                        <input asp-for="Longitude" class="form-control" inputmode="decimal" placeholder="7.99560" />
                        <span asp-validation-for="Longitude"></span>
                    </div>
                </div>
            </details>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">4</span> @T["Fortell mer og hvordan vi når deg"]</legend>

            <div class="felt">
                <label asp-for="Beskrivelse" class="form-label">@T["Beskrivelse"]</label>
                <textarea asp-for="Beskrivelse" class="form-control" rows="4" placeholder="@T["For eksempel hvor mange personer det gjelder, eller hva som har skjedd"]"></textarea>
                <span asp-validation-for="Beskrivelse"></span>
                <p class="kart-tips">@T["Når du velger behovstype, fyller vi inn noen spørsmål du kan svare på. Du kan endre teksten fritt."]</p>
            </div>

            <p class="felt-hjelp">@T["Oppgi telefon eller e-post, minst én av dem."]</p>
            <div class="felt-par">
                <div class="felt">
                    <label asp-for="KontaktTelefon" class="form-label">@T["Telefon"]</label>
                    <div class="telefon-rad">
                        <select asp-for="Landskode" class="form-select" aria-label="@T["Landskode"]">
                            @foreach (Land land in Land.Alle)
                            {
                                <option value="@land.Kode">@land.Kode @T[land.Navn]</option>
                            }
                        </select>
                        <input asp-for="KontaktTelefon" class="form-control" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="12345678" />
                    </div>
                    <span asp-validation-for="Landskode"></span>
                    <span asp-validation-for="KontaktTelefon"></span>
                </div>
                <div class="felt">
                    <label asp-for="KontaktEpost" class="form-label">@T["E-post"]</label>
                    <input asp-for="KontaktEpost" class="form-control" type="email" autocomplete="email" />
                    <span asp-validation-for="KontaktEpost"></span>
                    @if (!string.IsNullOrEmpty(Model.KontaktEpost) && Model.KontaktEpost == Tilgang.Epost(User))
                    {
                        <p class="kart-tips">@T["Hentet fra kontoen din. Du kan endre den."]</p>
                    }
                </div>
            </div>
        </fieldset>

        <div class="skjema-bunn">
            <button type="submit" class="btn btn-danger btn-lg">@(erNy ? T["Send inn"] : T["Lagre endringer"])</button>
            @if (erNy)
            {
                <a asp-controller="Ressurs" asp-action="Index" class="btn btn-outline-secondary btn-lg">@T["Avbryt"]</a>
            }
            else
            {
                <a asp-action="@(erKoordinator ? "Ko" : "MineBehov")" class="btn btn-outline-secondary btn-lg">@T["Avbryt"]</a>
            }
        </div>
    </form>

    <aside class="sidepanel sidepanel-nod" aria-labelledby="panel-tittel">
        <h2 id="panel-tittel">@T["Er det fare for liv?"]</h2>
        <p class="nod-tall">
            <a href="tel:110">@T["110 Brann"]</a>
            <a href="tel:112">@T["112 Politi"]</a>
            <a href="tel:113">@T["113 Ambulanse"]</a>
        </p>
        <p>@T["Ring først. BeredskapsPortalen er ikke en nødtjeneste, og du får ikke svar umiddelbart."]</p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
    <script src="~/js/kart.js" asp-append-version="true"></script>
    <script src="~/js/ressurs-skjema.js" asp-append-version="true"></script>
}
