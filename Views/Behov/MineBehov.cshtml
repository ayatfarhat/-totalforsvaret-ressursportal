@model BehovListeViewModel
@using System.Security.Claims
@using Nabohjelp.Models

@{
    ViewData["Title"] = T["Mine behov"];

    // Samme regel som i BehovController.MineBehov: ansatte ser alle behov.
    bool erAnsatt = Tilgang.ErAnsatt(User);

    // Brukes til å vise «Trekk tilbake» bare på behov brukeren selv har meldt.
    string? brukerId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@functions {
    // Forklaring under et behov som er avvist eller trukket tilbake.
    // Admin og Kommune ser alle behov, så teksten må passe for dem også.
    string AvsluttetTekst(BehovStatus status, bool erEgen)
    {
        if (status == BehovStatus.Rejected)
        {
            return "Kommunen har avvist behovet, for eksempel fordi det var meldt to ganger. Ta kontakt med kommunen hvis du fortsatt trenger hjelp.";
        }
        if (erEgen)
        {
            return "Du trakk tilbake dette behovet. Meld et nytt behov hvis du trenger hjelp igjen.";
        }
        return "Den som meldte behovet, trakk det tilbake.";
    }
}

<div class="side-topp">
    <h1>@(erAnsatt ? T["Alle registrerte behov"] : T["Mine behov"])</h1>
    <p class="ingress">@T["Her ser du hvor langt hvert behov har kommet: fra det er meldt, til kommunen vurderer det, sender en ressurs og markerer det som løst."]</p>
</div>

<partial name="_BehovFilter" model="Model" />

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

@if (Model.Liste.Count == 0 && Model.AntallAlle == 0 && !Model.HarFilter())
{
    <div class="tom-tilstand">
        <h2 class="h3">@T["Ingen behov er registrert"]</h2>
        <p>@T["Behov du melder, vises her med status."]</p>
        <a class="btn btn-danger" asp-controller="Behov" asp-action="Opprett">@T["Meld et behov"]</a>
    </div>
}
else if (Model.Liste.Count == 0)
{
    <div class="tom-tilstand">
        <h2 class="h3">@T["Ingen behov her"]</h2>
        <p>@T["Ingen behov passer filteret. Prøv en annen fane eller nullstill filteret."]</p>
    </div>
}
else
{
    <div class="liste-topp">
        <h2>@(erAnsatt ? T["Behov"] : T["Dine behov"])</h2>
        <span class="antall">@Model.Liste.Count</span>
    </div>

    <div class="behov-liste">
        @foreach (Behov behov in Model.Liste)
        {
            int steg = BehovStatusflyt.StegNummer(behov.Status);
            bool erEgen = !string.IsNullOrEmpty(brukerId) && behov.OpprettetAvBrukerId == brukerId;

            <article class="behov-kort @(behov.Prioritet == BehovPrioritet.Urgent ? "behov-akutt" : "")" aria-labelledby="behov-@behov.Id">
                <div class="behov-topp">
                    <h3 id="behov-@behov.Id">@Visningstekst.Type(behov.Type, behov.AnnetType)</h3>
                    <span class="merke @(behov.Prioritet == BehovPrioritet.Urgent ? "merke-hjelp" : "")">@Visningstekst.Prioritet(behov.Prioritet)</span>
                    <span class="merke @Visningstekst.StatusFarge(behov.Status)">@Visningstekst.Status(behov.Status)</span>
                </div>

                <p class="behov-meta">
                    @T["Meldt {0}", behov.OpprettetTid.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]
                    @if (Kommuner.Finnes(behov.Kommunenummer))
                    {
                        <text> · @Kommuner.VisNavn(behov.Kommunenummer)</text>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(behov.Beskrivelse))
                {
                    <p class="behov-tekst">@behov.Beskrivelse</p>
                }

                @if (steg >= 0)
                {
                    <ol class="statuslinje" aria-label="@T["Status"]: @Visningstekst.Status(behov.Status)">
                        @for (int i = 0; i < BehovStatusflyt.Steg.Length; i++)
                        {
                            // Et løst behov er ferdig helt ut: også siste steg blir grønt.
                            bool erLost = behov.Status == BehovStatus.Resolved;
                            string klasse = i < steg ? "ferdig" : i == steg ? (erLost ? "ferdig na" : "na") : "";
                            <li class="@klasse" aria-current="@(i == steg ? "step" : null)">@Visningstekst.Status(BehovStatusflyt.Steg[i])</li>
                        }
                    </ol>
                }
                else
                {
                    <p class="behov-avsluttet">@T[AvsluttetTekst(behov.Status, erEgen)]</p>
                }

                @if ((erEgen || erAnsatt) && BehovStatusflyt.KanRedigeres(behov.Status))
                {
                    <div class="behov-handling">
                        <a asp-controller="Behov" asp-action="Rediger" asp-route-id="@behov.Id" class="btn btn-sm btn-outline-secondary"
                           aria-label="@T["Endre behovet {0}, meldt {1}", Visningstekst.Type(behov.Type, behov.AnnetType), behov.OpprettetTid.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]">@T["Endre"]</a>
                        @if (erEgen && BehovStatusflyt.KanRedigeres(behov.Status))
                        {
                            <form asp-controller="Behov" asp-action="TrekkTilbake" asp-route-id="@behov.Id" method="post"
                                  onsubmit="return confirm('@T["Vil du trekke tilbake dette behovet? Kommunen slutter da å behandle det."]');">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Trekk tilbake"]</button>
                            </form>
                            <small class="dempet">@T["Trenger du ikke hjelpen lenger? Da kan kommunen bruke tiden på andre."]</small>
                        }
                    </div>
                }
            </article>
        }
    </div>
}

<div class="skjema-bunn">
    <a asp-controller="Behov" asp-action="Opprett" class="btn btn-danger">@T["Meld nytt behov"]</a>
    @if (erAnsatt)
    {
        <a asp-controller="Behov" asp-action="Ko" class="btn btn-outline-secondary">@T["Til behovskøen"]</a>
    }
</div>
