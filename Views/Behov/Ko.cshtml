@using Nabohjelp.Models
@model List<Nabohjelp.ViewModels.BehovKoItem>
@{
    ViewData["Title"] = "Behovskø";
}

@functions {
    // Norsk statustekst kommer fra Visningstekst, så alle sider bruker samme ord.
    string StatusTekst(BehovStatus status)
    {
        return Visningstekst.Status(status);
    }

    // Fargen på statusmerket.
    string StatusFarge(BehovStatus status)
    {
        if (status == BehovStatus.Assigned) return "merke-gi";
        if (status == BehovStatus.UnderReview) return "merke-lys";
        return "";
    }

    // Teksten på knappen som flytter behovet til neste status.
    string KnappTekst(BehovStatus nesteStatus)
    {
        if (nesteStatus == BehovStatus.UnderReview) return "Start vurdering";
        if (nesteStatus == BehovStatus.Resolved) return "Marker som løst";
        if (nesteStatus == BehovStatus.Rejected) return "Avvis";
        return "Neste status";
    }

    // «Avvis» er en avsluttende handling og får en annen farge enn de andre knappene.
    string KnappKlasse(BehovStatus nesteStatus)
    {
        if (nesteStatus == BehovStatus.Rejected) return "btn btn-sm btn-outline-danger";
        return "btn btn-sm btn-outline-secondary";
    }
}

<div class="side-topp">
    <h1>Behovskø</h1>
    <p class="ingress">Aktive behov, med de akutte først.</p>
</div>

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

@if (!Model.Any())
{
    <div class="tom-tilstand">
        <h3>Ingen aktive behov</h3>
        <p>Nye behov som meldes inn, dukker opp her.</p>
    </div>
}
else
{
    <div class="liste-topp">
        <h2>Aktive behov</h2>
        <span class="antall">@Model.Count</span>
    </div>

    <div class="table-responsive">
        <table class="table stablet align-middle">
            <thead>
                <tr>
                    <th scope="col">Type</th>
                    <th scope="col">Prioritet</th>
                    <th scope="col">Status</th>
                    <th scope="col">Beskrivelse</th>
                    <th scope="col">Registrert</th>
                    <th scope="col">Kontakt</th>
                    <th scope="col"><span class="visually-hidden">Handling</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr class="@(b.Prioritet == BehovPrioritet.Urgent ? "rad-akutt" : "")">
                        <td data-label="Type"><strong>@Nabohjelp.Models.Visningstekst.Type(b.Type)</strong></td>
                        <td data-label="Prioritet">
                            @if (b.Prioritet == BehovPrioritet.Urgent)
                            {
                                <span class="merke merke-hjelp">Akutt</span>
                            }
                            else
                            {
                                <span class="merke">Planlagt</span>
                            }
                        </td>
                        <td data-label="Status"><span class="merke @StatusFarge(b.Status)">@StatusTekst(b.Status)</span></td>
                        <td data-label="Beskrivelse">@(string.IsNullOrWhiteSpace(b.Beskrivelse) ? "Ingen beskrivelse" : b.Beskrivelse)</td>
                        <td data-label="Registrert">@b.OpprettetTid.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td data-label="Kontakt">
                            <span class="kontakt-liste">
                                @if (!string.IsNullOrWhiteSpace(b.KontaktTelefon))
                                {
                                    <a href="tel:@b.KontaktTelefon.Replace(" ", "")">@b.KontaktTelefon</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(b.KontaktEpost))
                                {
                                    <a href="mailto:@b.KontaktEpost">@b.KontaktEpost</a>
                                }
                            </span>
                        </td>
                        <td data-label="" class="ko-handling">
                            <div class="ko-knapper">
                                @foreach (var neste in b.MuligeNesteStatuser)
                                {
                                    <form asp-action="EndreStatus" method="post">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <input type="hidden" name="nyStatus" value="@neste" />
                                        <button type="submit" class="@KnappKlasse(neste)">@KnappTekst(neste)</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
