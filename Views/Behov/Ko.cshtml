@model BehovListeViewModel
@{
    ViewData["Title"] = T["Behovskø"];

    // Adressen til denne siden med valgt fane og filter. Sendes med statusknappene,
    // så man kommer tilbake til samme liste etterpå.
    string tilbake = Context.Request.Path + Context.Request.QueryString;
}

@functions {
    // Teksten på knappen som flytter behovet til neste status.
    string KnappTekst(BehovStatus nesteStatus)
    {
        if (nesteStatus == BehovStatus.UnderReview) return "Start vurdering";
        if (nesteStatus == BehovStatus.Resolved) return "Marker som løst";
        if (nesteStatus == BehovStatus.Rejected) return "Avvis";
        return "Neste status";
    }

    // «Avvis» er en avsluttende handling og får en annen farge enn de andre knappene.
    string KnappKlasse(BehovStatus nesteStatus)
    {
        if (nesteStatus == BehovStatus.Rejected) return "btn btn-sm btn-outline-danger";
        return "btn btn-sm btn-outline-secondary";
    }
}

<div class="side-topp">
    <h1>@T["Behovskø"]</h1>
    <p class="ingress">@T["Alle behov som er meldt inn, nyeste først. Bare kommunen og kriseledelsen ser denne lista."]</p>
</div>

<partial name="_BehovFilter" model="Model" />

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

@if (Model.Liste.Count == 0)
{
    <div class="tom-tilstand">
        <h2 class="h3">@T["Ingen behov her"]</h2>
        <p>@(Model.HarFilter() ? T["Ingen behov passer filteret. Prøv en annen fane eller nullstill filteret."] : T["Nye behov som meldes inn, dukker opp under «Åpne»."])</p>
    </div>
}
else
{
    <div class="liste-topp">
        <h2>@T["Behov"]</h2>
        <span class="antall">@Model.Liste.Count</span>
    </div>

    <div class="table-responsive">
        <table class="table stablet align-middle">
            <thead>
                <tr>
                    <th scope="col">@T["Type"]</th>
                    <th scope="col">@T["Posisjon"]</th>
                    <th scope="col">@T["Beskrivelse"]</th>
                    <th scope="col">@T["Status"]</th>
                    <th scope="col">@T["Registrert"]</th>
                    <th scope="col">@T["Kontakt"]</th>
                    <th scope="col"><span class="visually-hidden">@T["Handling"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (Behov b in Model.Liste)
                {
                    // Punktet på kartet som tekst, for eksempel «58.34, 8.59».
                    string koordinater = Visningstekst.Koordinat(b.Latitude) + ", " + Visningstekst.Koordinat(b.Longitude);
                    bool harPunkt = !(b.Latitude == 0 && b.Longitude == 0);

                    <tr class="@(b.Prioritet == BehovPrioritet.Urgent ? "rad-akutt" : "")">
                        <td data-label="@T["Type"]"><strong>@Visningstekst.Type(b.Type, b.AnnetType)</strong></td>
                        <td data-label="@T["Posisjon"]">
                            <span class="posisjon-celle">
                                <span>@Kommuner.VisNavn(b.Kommunenummer)</span>
                                @if (harPunkt)
                                {
                                    @* Åpner punktet i OpenStreetMap i en ny fane. *@
                                    <a href="@Visningstekst.KartLenke(b.Latitude, b.Longitude)" target="_blank" rel="noopener"
                                       aria-label="@T["Vis {0} på kart (åpnes i ny fane)", koordinater]">@koordinater</a>
                                }
                            </span>
                        </td>
                        <td data-label="@T["Beskrivelse"]"><span class="tekst-linjer">@(string.IsNullOrWhiteSpace(b.Beskrivelse) ? T["Ingen beskrivelse"] : b.Beskrivelse)</span></td>
                        <td data-label="@T["Status"]">
                            <span class="merke-stabel">
                                <span class="merke @Visningstekst.PrioritetFarge(b.Prioritet)">@Visningstekst.Prioritet(b.Prioritet)</span>
                                <span class="merke @Visningstekst.StatusFarge(b.Status)">@Visningstekst.Status(b.Status)</span>
                            </span>
                        </td>
                        <td data-label="@T["Registrert"]">@b.OpprettetTid.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td data-label="@T["Kontakt"]">
                            <span class="kontakt-liste">
                                @if (!string.IsNullOrWhiteSpace(b.KontaktTelefon))
                                {
                                    <a href="tel:@b.KontaktTelefon.Replace(" ", "")">@b.KontaktTelefon</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(b.KontaktEpost))
                                {
                                    <a href="mailto:@b.KontaktEpost">@b.KontaktEpost</a>
                                }
                            </span>
                        </td>
                        <td data-label="" class="ko-handling">
                            <div class="ko-knapper">
                                @foreach (BehovStatus neste in BehovStatusflyt.NesteStatuser(b.Status))
                                {
                                    <form asp-action="EndreStatus" method="post">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <input type="hidden" name="nyStatus" value="@neste" />
                                        <input type="hidden" name="tilbake" value="@tilbake" />
                                        <button type="submit" class="@KnappKlasse(neste)">@T[KnappTekst(neste)]</button>
                                    </form>
                                }
                                @if (BehovStatusflyt.KanRedigeres(b.Status))
                                {
                                    <a asp-action="Rediger" asp-route-id="@b.Id" class="btn btn-sm btn-link ko-endre"
                                       aria-label="@T["Endre behovet {0}, registrert {1}", Visningstekst.Type(b.Type, b.AnnetType), b.OpprettetTid.ToLocalTime().ToString("dd.MM.yyyy HH:mm")]">@T["Endre"]</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
