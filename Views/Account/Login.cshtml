@model LoginViewModel
@{
    ViewData["Title"] = "Logg inn";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>Logg inn</h1>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Epost" class="form-label">E-post</label>
                <input asp-for="Epost" class="form-control" />
                <span asp-validation-for="Epost" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Passord" class="form-label"></label>
                <input asp-for="Passord" class="form-control" />
                <span asp-validation-for="Passord" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Logg inn</button>
        </form>

        <p class="mt-3">Ingen konto? <a asp-action="Register">Registrer deg</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
