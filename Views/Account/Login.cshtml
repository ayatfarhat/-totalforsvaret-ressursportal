@model LoginViewModel
@{
    ViewData["Title"] = T["Logg inn"];
}

<div class="auth">
    <span class="logo-icon logo-icon-large"><partial name="_Logo" /></span>
    <h1>@T["Logg inn"]</h1>
    <p class="auth-ingress">@T["Logg inn for å melde behov eller registrere ressurser."]</p>

    @* Melding fra «Logg inn med Vipps/Apple», for eksempel at det ikke er slått på ennå. *@
    @if (TempData["Info"] is string info)
    {
        <div class="alert alert-info" role="status">@info</div>
    }

    <div class="auth-flate">
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>

            <div class="felt">
                <label asp-for="Epost" class="form-label">@T["E-post"]</label>
                <input asp-for="Epost" class="form-control" autocomplete="username" inputmode="email" />
                <span asp-validation-for="Epost"></span>
            </div>

            <div class="felt">
                <label asp-for="Passord" class="form-label">@T["Passord"]</label>
                <input asp-for="Passord" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Passord"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">@T["Logg inn"]</button>
        </form>

        <partial name="_EksternInnlogging" />
    </div>

    <p class="auth-bunn">@T["Har du ikke konto?"] <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">@T["Registrer deg"]</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
