@model RegisterViewModel
@{
    ViewData["Title"] = T["Registrer deg"];
}

<div class="auth">
    <span class="logo-icon logo-icon-large"><partial name="_Logo" /></span>
    <h1>@T["Registrer deg"]</h1>
    <p class="auth-ingress">@T["Nye brukere får rollen Frivillig."]</p>

    <div class="auth-flate">
        <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>
            <partial name="_Honningkrukke" />

            <div class="felt">
                <label asp-for="Epost" class="form-label">@T["E-post"]</label>
                <input asp-for="Epost" class="form-control" autocomplete="username" inputmode="email" />
                <span asp-validation-for="Epost"></span>
            </div>

            <div class="felt">
                <label asp-for="Passord" class="form-label">@T["Passord"]</label>
                <input asp-for="Passord" class="form-control" autocomplete="new-password" aria-describedby="passordHjelp" />
                <div id="passordHjelp" class="form-text">@T["Minst 8 tegn, med stor og liten bokstav, tall og spesialtegn (for eksempel !)."]</div>
                <span asp-validation-for="Passord"></span>
            </div>

            <div class="felt">
                <label asp-for="BekreftPassord" class="form-label">@T["Gjenta passord"]</label>
                <input asp-for="BekreftPassord" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="BekreftPassord"></span>
            </div>

            @* GDPR: brukeren må lese og godta vilkårene og personvernerklæringen før kontoen lages. *@
            <div class="felt form-check samtykke">
                <input asp-for="GodtarPersonvern" class="form-check-input" />
                <label asp-for="GodtarPersonvern" class="form-check-label">
                    @T["Jeg har lest"] <a asp-controller="Home" asp-action="Vilkar" target="_blank">@T["vilkårene"]</a> @T["og"] <a asp-controller="Home" asp-action="Personvern" target="_blank">@T["personvernerklæringen"]</a>@T[", og godtar at e-posten min lagres for å lage kontoen."]
                </label>
                <span asp-validation-for="GodtarPersonvern"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">@T["Opprett konto"]</button>
        </form>

        <partial name="_EksternInnlogging" />
    </div>

    <p class="auth-bunn">@T["Har du allerede konto?"] <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">@T["Logg inn"]</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
