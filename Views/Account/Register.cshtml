@model RegisterViewModel
@{
    ViewData["Title"] = "Registrer deg";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>Registrer deg</h1>
        <p class="text-muted">Nye brukere får rollen Frivillig.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Epost" class="form-label">E-post</label>
                <input asp-for="Epost" class="form-control" />
                <span asp-validation-for="Epost" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Passord" class="form-label"></label>
                <input asp-for="Passord" class="form-control" />
                <div class="form-text">Minst 8 tegn og minst ett tall.</div>
                <span asp-validation-for="Passord" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BekreftPassord" class="form-label"></label>
                <input asp-for="BekreftPassord" class="form-control" />
                <span asp-validation-for="BekreftPassord" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Opprett konto</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
