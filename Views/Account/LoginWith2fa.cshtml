@model TofaViewModel
@{
    ViewData["Title"] = "Skriv inn kode";
}

<div class="auth">
    <span class="logo-icon logo-icon-large"><partial name="_Logo" /></span>
    <h1>@T["Skriv inn kode"]</h1>
    <p class="auth-ingress">@T["Åpne autentiseringsappen og skriv inn den 6-sifrede koden."]</p>

    <div class="auth-flate">
        <form asp-action="LoginWith2fa" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div class="felt">
                <label asp-for="Kode" class="form-label">@T["Kode fra appen"]</label>
                <input asp-for="Kode" class="form-control kode-felt" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" />
                <span asp-validation-for="Kode"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">@T["Logg inn"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
