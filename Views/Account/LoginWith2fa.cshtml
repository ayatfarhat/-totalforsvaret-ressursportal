@model TofaViewModel
@{
    ViewData["Title"] = "Skriv inn kode";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>Skriv inn kode</h1>
        <p>Åpne autentiseringsappen og skriv inn den 6-sifrede koden.</p>

        <form asp-action="LoginWith2fa" method="post">
            <div class="mb-3">
                <label asp-for="Kode" class="form-label"></label>
                <input asp-for="Kode" class="form-control" />
                <span asp-validation-for="Kode" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Logg inn</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
