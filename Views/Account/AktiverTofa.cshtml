@model TofaViewModel
@{
    ViewData["Title"] = "Slå på 2FA";

    // Teksten som gjøres om til QR-kode. Autentiseringsappen forstår dette formatet.
    var qrTekst = "otpauth://totp/Kriseportal:" + User.Identity?.Name + "?secret=" + Model.Nokkel + "&issuer=Kriseportal";
}

<div class="smal-side">
    <div class="sidetopp">
        <a class="tilbakelenke" asp-action="Index">&larr; Min konto</a>
        <h1>Slå på 2FA</h1>
        <p class="ingress">Totrinnsbekreftelse gjør kontoen din tryggere. Du trenger en autentiseringsapp på mobilen.</p>
    </div>

    <form asp-action="AktiverTofa" method="post" class="panel">
        @* Nøkkelen sendes med, så den kan vises igjen hvis koden er feil *@
        <input type="hidden" asp-for="Nokkel" />

        <fieldset class="skjemadel">
            <legend>1. Skann QR-koden</legend>
            <p class="legend-hjelp">Bruk Microsoft Authenticator eller Google Authenticator.</p>
            <div id="qrkode" class="qrkode mb-2"></div>
            <p class="form-text">Får du ikke skannet? Skriv inn denne nøkkelen i appen: <code class="nokkel">@Model.Nokkel</code></p>
        </fieldset>

        <fieldset class="skjemadel">
            <legend>2. Skriv inn koden fra appen</legend>
            <div class="mb-4">
                <label asp-for="Kode" class="visually-hidden"></label>
                <input asp-for="Kode" class="form-control kodefelt" inputmode="numeric" autocomplete="one-time-code" placeholder="000000" />
                <span asp-validation-for="Kode"></span>
            </div>
        </fieldset>

        <button type="submit" class="btn btn-primary btn-lg w-100">Slå på 2FA</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrkode"), { text: "@Html.Raw(qrTekst)", width: 180, height: 180 });
    </script>
}
