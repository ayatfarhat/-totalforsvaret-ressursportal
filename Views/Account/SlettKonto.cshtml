@model SlettKontoViewModel

@{
    ViewData["Title"] = T["Slett konto"];
}

<div class="auth auth-bred">
    <h1>@T["Slett konto"]</h1>

    <div class="alert alert-danger" role="alert">
        <h2 class="h5">@T["Advarsel: Permanent sletting"]</h2>
        <p>@T["Hvis du sletter kontoen din, vil alle behov og ressurser du har registrert, også bli slettet permanent."]</p>
        <p class="mb-0"><strong>@T["Handlingen kan ikke angres!"]</strong></p>
    </div>

    <p>
        @T["Vil du ta vare på opplysningene først?"]
        <a asp-action="LastNedMineData">@T["Last ned mine data"]</a>
    </p>

    <div class="auth-flate">
        <form asp-controller="Account" asp-action="SlettKonto" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>

            @* Brukere som logger inn med Vipps eller Apple har ikke passord hos oss. *@
            @if (ViewData["HarPassord"] is bool harPassord && !harPassord)
            {
                <p>@T["Du logger inn med Vipps eller Apple, så du trenger ikke passord for å slette kontoen."]</p>
            }
            else
            {
                <div class="felt">
                    <label asp-for="Passord" class="form-label">@T["Skriv inn passordet ditt for å bekrefte"]</label>
                    <input asp-for="Passord" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Passord"></span>
                </div>
            }

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-danger">@T["Ja, slett kontoen min permanent"]</button>
                <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary">@T["Avbryt"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
