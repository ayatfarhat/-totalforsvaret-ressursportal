@model KontoViewModel

@{
    ViewData["Title"] = "Min konto";
}

<div class="auth auth-bred">
    <h1>@T["Min konto"]</h1>
    <p class="auth-ingress">@T["Her ser du hvordan du er logget inn."]</p>

    <div class="auth-flate">
        <dl class="konto-rutenett">
            <div>
                <dt>@T["E-post"]</dt>
                <dd>@Model.Epost</dd>
            </div>

            <div>
                <dt>@T["Rolle"]</dt>
                <dd>@Model.Rolle</dd>
            </div>

            <div>
                <dt>2FA</dt>
                <dd>
                    @if (Model.TofaErPa)
                    {
                        <span class="merke merke-gi">@T["På"]</span>
                    }
                    else
                    {
                        <span class="merke merke-lys">@T["Av"]</span>
                    }
                </dd>
            </div>
        </dl>
    </div>

    <!-- SIKKERHET -->
    <div class="auth-flate mt-4">
        <h2>@T["Sikkerhet"]</h2>

        @if (Model.TofaErPa)
        {
            <p class="dempet">@T["Kontoen din er beskyttet med kode fra autentiseringsapp."]</p>
        }
        else
        {
            <p class="dempet">@T["Tofaktor-innlogging gir ekstra beskyttelse hvis noen får tak i passordet ditt."]</p>
        }

        <div class="d-flex gap-3 flex-wrap mt-3">
            @if (Model.TofaErPa)
            {
                <form asp-action="DeaktiverTofa" method="post">
                    <button type="submit" class="btn btn-outline-secondary">@T["Slå av 2FA"]</button>
                </form>
            }
            else
            {
                <a asp-action="AktiverTofa" class="btn btn-primary">@T["Slå på 2FA"]</a>
            }

            <a asp-action="EndrePassord" class="btn btn-outline-secondary">@T["Endre passord"]</a>
        </div>
    </div>

    <!-- MINE REGISTRERINGER -->
    <div class="auth-flate mt-4">
        <h2>@T["Mine registreringer"]</h2>

        <p class="dempet">@T["Her finner du behovene og ressursene du har registrert."]</p>

        <div class="d-flex gap-3 flex-wrap mt-3">
            <a asp-controller="Behov" asp-action="MineBehov" class="btn btn-primary">@T["Mine behov"]</a>
            <a asp-controller="Ressurs" asp-action="Index" class="btn btn-primary">@T["Mine ressurser"]</a>
        </div>
    </div>

    <!-- PERSONVERN (GDPR) -->
    <div class="auth-flate mt-4">
        <h2>@T["Personvern og dine data"]</h2>

        <p class="dempet">
            @T["Du kan når som helst laste ned alt vi har lagret om deg, eller slette kontoen."]
            <a asp-controller="Home" asp-action="Personvern">@T["Les personvernerklæringen"]</a>
        </p>

        <div class="d-flex gap-3 flex-wrap mt-3">
            <a asp-action="LastNedMineData" class="btn btn-outline-secondary">@T["Last ned mine data"]</a>
            <a asp-action="SlettKonto" class="btn btn-outline-danger">@T["Slett konto"]</a>
        </div>
    </div>
</div>
