@model KontoViewModel

@{
    ViewData["Title"] = "Min konto";
}

<div class="auth auth-bred">
    <h1>Min konto</h1>
    <p class="auth-ingress">Her ser du hvordan du er logget inn.</p>

    <div class="auth-flate">
        <dl class="konto-rutenett">
            <div>
                <dt>E-post</dt>
                <dd>@Model.Epost</dd>
            </div>

            <div>
                <dt>Rolle</dt>
                <dd>@Model.Rolle</dd>
            </div>

            <div>
                <dt>2FA</dt>
                <dd>
                    @if (Model.TofaErPa)
                    {
                        <span class="merke merke-gi">På</span>
                    }
                    else
                    {
                        <span class="merke merke-lys">Av</span>
                    }
                </dd>
            </div>
        </dl>

        @if (!Model.TofaErPa)
        {
            <div class="mt-4">
                <p class="dempet mb-3">
                    Tofaktor-innlogging gir ekstra beskyttelse
                    hvis noen får tak i passordet ditt.
                </p>

                <a asp-action="AktiverTofa"
                   class="btn btn-primary">
                    Slå på 2FA
                </a>
            </div>
        }
    </div>

    <!-- MINE REGISTRERINGER -->
    <div class="auth-flate mt-4">
        <h2>Mine registreringer</h2>

        <p class="dempet">
            Her finner du behovene og ressursene du har registrert.
        </p>

        <div class="d-flex gap-3 flex-wrap mt-3">

            <a asp-controller="Behov"
               asp-action="MineBehov"
               class="btn btn-primary">
                Mine behov
            </a>

            <a asp-controller="Ressurs"
               asp-action="Index"
               class="btn btn-primary">
                Mine ressurser
            </a>

        </div>
    </div>
</div>

<hr />

<h3>Slett brukerkonto</h3>

<p>
    Hvis du sletter kontoen din, vil alle behov og ressurser
    du har registrert, også bli slettet permanent.
</p>

<a asp-controller="Account"
   asp-action="SlettKonto"
   class="btn btn-danger">
    Slett konto
</a>