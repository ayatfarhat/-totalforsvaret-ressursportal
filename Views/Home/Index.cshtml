@{
    ViewData["Title"] = "Forside";
    bool erInnlogget = User.Identity != null && User.Identity.IsAuthenticated;
}

@* ---------------------------------------------------------------
   Forsiden. Det viktigste kommer først: de to store valgene
   "Jeg trenger hjelp" (rød) og "Jeg kan hjelpe" (grønn).
   Deretter en kort forklaring i tre steg.
   Alle farger og former kommer fra site.css.
   --------------------------------------------------------------- *@

<section class="forside-topp">
    <h1>Når krisen rammer, er det naboen som når frem først.</h1>
    <p class="ingress">
        Nabohjelp kobler folk som trenger hjelp under strømbrudd, ekstremvær
        eller evakuering med naboer som kan stille med utstyr, kjøretøy,
        husrom eller egen innsats.
    </p>
</section>

<section class="valg" aria-label="Hva vil du gjøre?">
    <a class="valg-knapp valg-hjelp" asp-controller="Behov" asp-action="Opprett">
        <span class="valg-tittel">Jeg trenger hjelp</span>
        <span class="valg-tekst">Meld inn hva du trenger og hvor du er, så kan kommunen sende hjelp.</span>
        @if (!erInnlogget)
        {
            <span class="valg-merknad">Du må logge inn først.</span>
        }
        <span class="valg-bunn">
            <span class="valg-handling">Meld inn behov</span>
        </span>
    </a>

    <a class="valg-knapp valg-bidra" asp-controller="Ressurs" asp-action="Create">
        <span class="valg-tittel">Jeg kan hjelpe</span>
        <span class="valg-tekst">Registrer utstyr, kjøretøy, lokaler eller deg selv som frivillig.</span>
        <span class="valg-bunn">
            <span class="valg-handling">Registrer en ressurs</span>
        </span>
    </a>
</section>

<section class="steg-seksjon" id="steg">
    <h2>Slik fungerer det</h2>

    <ol class="steg-liste">
        <li>
            <span class="steg-nummer">1</span>
            <h3>Velg hva du vil gjøre</h3>
            <p>Trykk &laquo;Jeg trenger hjelp&raquo; eller &laquo;Jeg kan hjelpe&raquo;. Hver har sitt eget korte skjema.</p>
        </li>
        <li>
            <span class="steg-nummer">2</span>
            <h3>Fyll ut skjemaet</h3>
            <p>Hva det gjelder, hvor du er, og eventuelt navn og telefon. Det tar under ett minutt.</p>
        </li>
        <li>
            <span class="steg-nummer">3</span>
            <h3>Få kvittering</h3>
            <p>Du ser en kvittering med en gang, og kriseledelsen ser meldingen din.</p>
        </li>
    </ol>
</section>

<section class="etat-lenke">
    <p><strong>Jobber du i kommunen, nødetatene eller kriseledelsen?</strong> Logg inn for å se kart, behovskø og tildeling.</p>
    @if (User.IsInRole("Admin") || User.IsInRole("Kommune"))
    {
        <a class="btn btn-primary" asp-controller="Kommandobro" asp-action="Index">Åpne Kommandobro</a>
    }
    else if (!erInnlogget)
    {
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Logg inn</a>
    }
</section>
