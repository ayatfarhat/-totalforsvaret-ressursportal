@{
    ViewData["Title"] = T["Forside"];
}

@* ---------------------------------------------------------------
   Forsiden. Øverst: hva BeredskapsPortalen er, og de to valgene man faktisk
   kommer for å gjøre. Illustrasjonen er et kart over en kystkommune der
   noen trenger hjelp (rød markør) og ressurser kan sendes dit (grønne markører).
   --------------------------------------------------------------- *@

<section class="hero" aria-labelledby="hero-tittel">
    <div class="hero-tekst">
        <h1 id="hero-tittel">@T["Rett ressurs til rett sted når krisen rammer."]</h1>
        <p class="hero-ingress">
            @T["Strømbrudd, ekstremvær eller evakuering: BeredskapsPortalen samler utstyr, kjøretøy og frivillige på ett sted, slik at kriseledelsen raskt kan sende hjelp dit den trengs."]
        </p>

        <div class="hero-valg">
            <a class="valg valg-hjelp" asp-controller="Behov" asp-action="Opprett">
                <strong>@T["Jeg trenger hjelp"]</strong>
                <span>@T["Meld et behov i nærheten av deg"]</span>
            </a>
            <a class="valg valg-gi" asp-controller="Ressurs" asp-action="Create">
                <strong>@T["Jeg kan hjelpe"]</strong>
                <span>@T["Registrer utstyr, kjøretøy eller innsats"]</span>
            </a>
        </div>
        <p class="hero-merknad">@T["Er det fare for liv og helse, ring 110, 112 eller 113 først."]</p>
    </div>

    <figure class="hero-bilde">
        <div class="scene" role="img"
             aria-label="@T["Eksempel fra en uværsnatt: Et behov for strøm til en omsorgsbolig i Grimstad blir koblet med et aggregat som en frivillig har registrert 2,4 kilometer unna."]">

            @* Bakgrunn: uvær om natten, regn og en strømlinje som har falt ned *@
            <svg class="scene-bakgrunn" viewBox="0 0 560 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="uvaer-himmel" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#0B1620" />
                        <stop offset="1" stop-color="#1E3A50" />
                    </linearGradient>
                </defs>
                <rect width="560" height="400" fill="url(#uvaer-himmel)" />

                @* Regn *@
                <g stroke="#9DB4C6" stroke-width="1.4" stroke-linecap="round" opacity=".16">
                    <path d="M40 20l-14 34M110 6l-14 34M180 30l-14 34M250 4l-14 34M320 24l-14 34M390 8l-14 34M460 28l-14 34M530 10l-14 34" />
                    <path d="M70 110l-14 34M140 96l-14 34M210 120l-14 34M280 92l-14 34M350 114l-14 34M420 100l-14 34M490 118l-14 34" />
                    <path d="M30 200l-14 34M100 186l-14 34M170 210l-14 34M240 184l-14 34M310 206l-14 34M380 190l-14 34M450 212l-14 34M520 194l-14 34" />
                </g>

                @* Åser *@
                <path d="M0 330c60-30 120-40 190-26 60 12 100 6 160-14 70-24 140-20 210 6v104H0Z" fill="#162C3D" />
                <path d="M0 360c80-18 160-20 250-8 80 10 170 4 310-14v62H0Z" fill="#0F2131" />

                @* Strømmaster. Linjen mellom de to siste har falt ned *@
                <g stroke="#3E5D75" stroke-width="4" stroke-linecap="round">
                    <path d="M70 360V262M52 272h36" />
                    <path d="M230 352V250M212 260h36" />
                    <path d="M390 348v-98M372 260h36" />
                </g>
                <g fill="none" stroke="#3E5D75" stroke-width="2">
                    <path d="M52 272c50 18 110 18 160-12M88 272c50 18 110 18 160-12" />
                    <path d="M248 260c30 14 60 24 70 60M408 260c-10 30-14 60-8 92" />
                </g>
                @* Gnist ved bruddet *@
                <g stroke="#F4B740" stroke-width="2.4" stroke-linecap="round">
                    <path d="M318 322l-8-6M320 326l2-10M322 324l9-4" />
                </g>
            </svg>

            <p class="scene-varsel"><span class="varsel-trekant" aria-hidden="true"></span>@T["Oransje farevarsel: kraftig vind"]</p>

            <div class="scene-kort kort-behov">
                <span class="kort-ikon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" fill="currentColor" /><path d="M3 3l18 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
                </span>
                <span class="kort-tekst">
                    <strong>@T["Strøm til omsorgsbolig"]</strong>
                    <span>@T["Grimstad, meldt kl. 18.42"]</span>
                </span>
                <span class="kort-status status-haster"><i class="signal"></i>@T["Haster"]</span>
            </div>

            <div class="scene-kobling" aria-hidden="true">
                <svg viewBox="0 0 200 60" preserveAspectRatio="none" focusable="false"><path d="M20 0C20 34 180 26 180 60" fill="none" stroke="#F4B740" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9" vector-effect="non-scaling-stroke" /></svg>
                <span class="kobling-merke">
                    <svg viewBox="0 0 16 16" focusable="false"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    @T["Tildelt"]
                </span>
            </div>

            <div class="scene-kort kort-ressurs">
                <span class="kort-ikon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="7" width="18" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M7 7V5h4v2M13 10l-2 3h3l-2 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M6 19v2M18 19v2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
                </span>
                <span class="kort-tekst">
                    <strong>@T["Aggregat, 6 kW"]</strong>
                    <span>@T["Frivillig, 2,4 km unna"]</span>
                </span>
                <span class="kort-status status-klar">@T["Tilgjengelig"]</span>
            </div>
        </div>
        <figcaption>
            <span><i style="background:#E5522C"></i>@T["Trenger hjelp"]</span>
            <span><i style="background:#4FD39A"></i>@T["Kan hjelpe"]</span>
        </figcaption>
    </figure>
</section>

<section class="seksjon" aria-labelledby="slik-tittel">
    <h2 id="slik-tittel">@T["Slik fungerer det"]</h2>
    <ol class="steg">
        <li>
            <h3>@T["Velg riktig spor"]</h3>
            <p>@T["Trenger du hjelp, eller kan du hjelpe andre? Hvert spor har sitt eget, korte skjema."]</p>
        </li>
        <li>
            <h3>@T["Fortell hva og hvor"]</h3>
            <p>@T["Velg type, pek ut stedet på kartet og legg inn hvordan du kan nås. Det tar under ett minutt."]</p>
        </li>
        <li>
            <h3>@T["Kriseledelsen ser det"]</h3>
            <p>@T["Meldingen vises på kartet til kriseledelsen med en gang, og de kobler behov med ressurser."]</p>
        </li>
    </ol>
</section>

<section class="seksjon" aria-labelledby="dele-tittel">
    <h2 id="dele-tittel">@T["Dette kan du stille med"]</h2>
    <ul class="deleliste">
        @foreach (var type in RessursFormViewModel.Typer)
        {
            <li>@T[type]</li>
        }
    </ul>
</section>
