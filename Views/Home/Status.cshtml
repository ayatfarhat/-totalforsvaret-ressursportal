@{
    int kode = ViewBag.Kode ?? 0;

    // Overskrift og forklaring ut fra feilkoden.
    string tittel = T["Noe gikk galt"];
    string tekst = T["Forespørselen kunne ikke fullføres (feilkode {0}). Gå tilbake og prøv igjen.", kode];

    if (kode == 404)
    {
        tittel = T["Siden finnes ikke"];
        tekst = T["Vi fant ikke siden du lette etter. Den kan være flyttet, eller lenken kan være feil."];
    }
    else if (kode == 429)
    {
        // Gis av fartsgrensen for innlogging i Program.cs (AddRateLimiter).
        tittel = T["For mange forsøk"];
        tekst = T["Du har prøvd for mange ganger på kort tid. Vent ett minutt og prøv igjen."];
    }

    ViewData["Title"] = tittel;
}

<div class="melding-side">
    <svg class="symbol" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
        <circle cx="36" cy="36" r="34" fill="#FCE9E3" stroke="#C93A17" stroke-width="3" />
        <path d="M36 20v20" stroke="#A52E10" stroke-width="6" stroke-linecap="round" />
        <circle cx="36" cy="51" r="3.6" fill="#A52E10" />
    </svg>
    <h1>@tittel</h1>
    <p>@tekst</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@T["Til forsiden"]</a>
</div>
