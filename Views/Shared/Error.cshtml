@model ErrorViewModel
@{
    ViewData["Title"] = "Noe gikk galt";
}

<div class="smal-side">
    <div class="sidetopp">
        <h1>Noe gikk galt</h1>
        <p class="ingress">Siden kunne ikke vises. Prøv igjen om litt, eller gå tilbake til forsiden.</p>
    </div>

    <div class="melding melding-feil">
        <strong>Akutt fare for liv og helse?</strong> Ikke vent på denne siden. Ring 110, 112 eller 113.
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">Feilkode: <code>@Model.RequestId</code></p>
    }

    <div class="knapperad">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Til forsiden</a>
    </div>
</div>
