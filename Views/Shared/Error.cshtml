@model ErrorViewModel
@{
    ViewData["Title"] = "Noe gikk galt";
}

<div class="melding-side">
    <svg class="symbol" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
        <circle cx="36" cy="36" r="34" fill="#FCE9E3" stroke="#C93A17" stroke-width="3" />
        <path d="M36 20v20" stroke="#A52E10" stroke-width="6" stroke-linecap="round" />
        <circle cx="36" cy="51" r="3.6" fill="#A52E10" />
    </svg>
    <h1>Noe gikk galt</h1>
    <p>Beklager, siden kunne ikke vises. Prøv igjen om litt, eller gå tilbake til forsiden.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Til forsiden</a>

    @if (Model != null && Model.ShowRequestId)
    {
        <small>Feilreferanse: <code>@Model.RequestId</code></small>
    }
</div>
