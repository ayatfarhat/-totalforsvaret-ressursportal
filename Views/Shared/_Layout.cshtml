<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Sidetittel -->
    <title>@ViewData["Title"] - Nabohjelp</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Prosjektets CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Skrifttyper brukt i Nabohjelp -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">
</head>

<body>

    <!-- Navigasjon -->
    <header>

        <!-- Sikkerhetsinformasjon -->
        <div class="safety-banner">
            Akutt fare for liv og helse? Ring 112/113/110.
        </div>

        <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- Logo og lenke til forsiden -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="logo-icon logo-icon-small">
                        <partial name="_Logo" />
                    </span>

                    Nabohjelp
                </a>

                <!-- Mobilmeny -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigasjonslenker -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Forside -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Forside
                            </a>
                        </li>

                        <!-- Ressurser / Nabohjelp -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Ressurs"
                               asp-action="Index">
                                Nabohjelp
                            </a>
                        </li>

                    </ul>

                    <!-- Vises bare for Admin/Kommune. Kartet over behov/ressurser
                         ligger nå direkte inne på Kommandobro-siden, ikke som egen lenke. -->
                    <ul class="navbar-nav">
                        @if (User.IsInRole("Admin") || User.IsInRole("Kommune"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-muted small"
                                   asp-area=""
                                   asp-controller="Kommandobro"
                                   asp-action="Index">
                                    For nødetater/politi &rarr;
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Innlogging / registrering -->
                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <!-- Hovedinnhold -->
    <div class="container">
        <main role="main" class="pb-3">

            <!-- Viser meldinger sendt fra controller -->
            @if (TempData["Melding"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Melding"]
                </div>
            }

            @RenderBody()

        </main>
    </div>

    <!-- Bunntekst -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Nabohjelp - Gruppe 15
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>