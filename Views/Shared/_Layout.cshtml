@{
    // Hvilken side vi er på. Brukes til å markere riktig lenke i menyen.
    var side = ViewContext.RouteData.Values["controller"]?.ToString();

    // Tittelen på fanen, oversatt hvis engelsk er valgt.
    var tittel = ViewData["Title"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "nb")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#12212D" />

    <title>@(string.IsNullOrEmpty(tittel) ? "" : T[tittel].Value) - BeredskapsPortalen</title>

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preload" href="~/fonts/familjen-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>

    <a class="hopp-lenke" href="#innhold">@T["Hopp til innhold"]</a>

    <header>
        @* Nødnumrene ligger alltid øverst. På mobil kan de trykkes for å ringe. *@
        <div class="nodstripe">
            <div class="container">
                <p><strong>@T["Akutt fare for liv og helse?"]</strong> @T["Ring først:"]</p>
                <ul>
                    <li><a href="tel:110">110 @T["Brann"]</a></li>
                    <li><a href="tel:112">112 @T["Politi"]</a></li>
                    <li><a href="tel:113">113 @T["Ambulanse"]</a></li>
                </ul>
            </div>
        </div>

        <div class="topp">
            <nav class="navbar navbar-expand-md" aria-label="@T["Hovedmeny"]">
                <div class="container">

                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="logo-icon logo-icon-small"><partial name="_Logo" /></span>
                        BeredskapsPortalen
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#hovedmeny"
                            aria-controls="hovedmeny"
                            aria-expanded="false"
                            aria-label="@T["Åpne og lukk meny"]">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse justify-content-between" id="hovedmeny">
                        <ul class="navbar-nav ms-md-3">
                            <li class="nav-item">
                                <a class="nav-link @(side == "Home" ? "active" : "")"
                                   asp-area="" asp-controller="Home" asp-action="Index">@T["Forside"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(side == "Ressurs" || side == "Behov" || side == "OnsketRessurs" ? "active" : "")"
                                   asp-area="" asp-controller="Ressurs" asp-action="Index">@T["Ressurser"]</a>
                            </li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Kommune"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(side == "Kommandobro" || side == "Tildeling" ? "active" : "")"
                                       asp-area="" asp-controller="Kommandobro" asp-action="Index">Kommandobro</a>
                                </li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(side == "Admin" ? "active" : "")"
                                       asp-area="" asp-controller="Admin" asp-action="Index">@T["Brukere"]</a>
                                </li>
                            }
                        </ul>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main id="innhold" tabindex="-1">
        <div class="container">

            @* Meldinger fra controller, for eksempel «Ressursen er tildelt». *@
            @if (TempData["Melding"] is string melding)
            {
                <div class="alert alert-success mt-4" role="status">

                    <p class="mb-2">@melding</p>

                    @* Knappen vises bare etter registrering av et behov. *@
                    @if (TempData["VisMineBehovKnapp"] is bool visKnapp && visKnapp)
                    {
                        <a asp-controller="Behov"
                           asp-action="MineBehov"
                           class="btn btn-primary mt-2">
                            @T["Se mine behov"]
                        </a>
                    }

                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="sidefot">
        <div class="container">
            <div class="fot-rutenett">
                <div>
                    <div class="fot-merke">
                        <span class="logo-icon logo-icon-small"><partial name="_Logo" /></span>
                        BeredskapsPortalen
                    </div>
                    <p>@T["En beredskapsportal som kobler behov under kriser med utstyr, kjøretøy og frivillige som kan stille opp."]</p>
                </div>
                <div>
                    <h2>@T["Sider"]</h2>
                    <ul>
                        <li><a asp-controller="Ressurs" asp-action="Index">@T["Ressurser og behov"]</a></li>
                        <li><a asp-controller="Behov" asp-action="Opprett">@T["Meld behov"]</a></li>
                        <li><a asp-controller="Ressurs" asp-action="Create">@T["Registrer en ressurs"]</a></li>
                        <li><a asp-controller="OnsketRessurs" asp-action="Index">@T["Ønskede ressurser"]</a></li>
                        <li><a asp-controller="Kommandobro" asp-action="Index">@T["For nødetater og kriseledelse"]</a></li>
                        <li><a asp-controller="Home" asp-action="Personvern">@T["Personvern"]</a></li>
                    </ul>
                </div>
            </div>
            <p class="fot-bunn">&copy; 2026 BeredskapsPortalen. @T["Studentprosjekt i IS-200, gruppe 15. BeredskapsPortalen erstatter ikke nødnumrene."]</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>