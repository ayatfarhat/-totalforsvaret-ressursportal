@{
    // Hvilken side vi er på. Brukes til å markere riktig lenke i menyen.
    // ("" + verdi gir tom tekst hvis verdien mangler.)
    string side = "" + ViewContext.RouteData.Values["controller"];
    string handling = "" + ViewContext.RouteData.Values["action"];

    // Hvilken lenke i menyen som er valgt. Den får en strek under (class="active")
    // og aria-current="page", så skjermlesere sier at det er siden du er på.
    bool paForside = side == "Home" && handling == "Index";
    bool paBehovsko = side == "Behov" && handling == "Ko";
    bool paRessursliste = side == "Ressurs" && (handling == "Oversikt" || handling == "Utskrift");
    bool paRessurser = (side == "Ressurs" || side == "Behov" || side == "OnsketRessurs") && !paBehovsko && !paRessursliste;
    bool paKriseledelse = paBehovsko || paRessursliste || side == "Kommandobro" || side == "Tildeling" || side == "Admin";

    // Tittelen på fanen, oversatt hvis engelsk er valgt.
    string tittel = "" + ViewData["Title"];
}
<!DOCTYPE html>
<html lang="@Oversetter.Sprakkode()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#12212D" />

    <title>@(string.IsNullOrEmpty(tittel) ? "" : T[tittel].Value) - BeredskapsPortalen</title>

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preload" href="~/fonts/familjen-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>

    <a class="hopp-lenke" href="#innhold">@T["Hopp til innhold"]</a>

    <header>
        @* Nødnumrene ligger alltid øverst. Et trykk ringer nummeret (tel:-lenke).
           Språkknappen står helt ut i høyre hjørne av stripa. *@
        <div class="nodstripe">
            <div class="nodstripe-innhold">
                <p><strong>@T["Akutt fare for liv og helse?"]</strong> <span class="nod-ring">@T["Ring først:"]</span></p>
                <ul>
                    <li><a href="tel:110" aria-label="@T["Ring {0}, {1}", "110", T["Brann"]]"><partial name="_Telefonikon" /><strong>110</strong> @T["Brann"]</a></li>
                    <li><a href="tel:112" aria-label="@T["Ring {0}, {1}", "112", T["Politi"]]"><partial name="_Telefonikon" /><strong>112</strong> @T["Politi"]</a></li>
                    <li><a href="tel:113" aria-label="@T["Ring {0}, {1}", "113", T["Ambulanse"]]"><partial name="_Telefonikon" /><strong>113</strong> @T["Ambulanse"]</a></li>
                </ul>
                <partial name="_SprakValg" />
            </div>
        </div>

        <div class="topp">
            <nav class="navbar navbar-expand-lg" aria-label="@T["Hovedmeny"]">
                <div class="container">

                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <span class="logo-icon logo-icon-small"><partial name="_Logo" /></span>
                        BeredskapsPortalen
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#hovedmeny"
                            aria-controls="hovedmeny"
                            aria-expanded="false"
                            aria-label="@T["Åpne og lukk meny"]">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse justify-content-between" id="hovedmeny">
                        <ul class="navbar-nav ms-lg-3">
                            <li class="nav-item">
                                <a class="nav-link @(paForside ? "active" : "")" aria-current="@(paForside ? "page" : null)"
                                   asp-controller="Home" asp-action="Index">@T["Forside"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(paRessurser ? "active" : "")" aria-current="@(paRessurser ? "page" : null)"
                                   asp-controller="Ressurs" asp-action="Index">@T["Ressurser"]</a>
                            </li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Kommune"))
                            {
                                @* Sidene for kriseledelsen ligger samlet i én meny (dropdown), så
                                   menylinjen ikke blir for trang. Admin har også «Brukere» her. *@
                                <li class="nav-item dropdown">
                                    <button type="button" class="nav-link dropdown-toggle @(paKriseledelse ? "active" : "")"
                                            data-bs-toggle="dropdown" aria-expanded="false">@T["Kriseledelse"]</button>
                                    <ul class="dropdown-menu brukermeny">
                                        <li><a class="dropdown-item" aria-current="@(paBehovsko ? "page" : null)" asp-controller="Behov" asp-action="Ko">@T["Behovskø"]</a></li>
                                        <li><a class="dropdown-item" aria-current="@(paRessursliste ? "page" : null)" asp-controller="Ressurs" asp-action="Oversikt">@T["Ressursliste"]</a></li>
                                        <li><a class="dropdown-item" aria-current="@(side == "Tildeling" ? "page" : null)" asp-controller="Tildeling" asp-action="Index">@T["Tildeling"]</a></li>
                                        <li><a class="dropdown-item" aria-current="@(side == "Kommandobro" ? "page" : null)" asp-controller="Kommandobro" asp-action="Index">@T["Kommandobro"]</a></li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><a class="dropdown-item" aria-current="@(side == "Admin" ? "page" : null)" asp-controller="Admin" asp-action="Index">@T["Brukere"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(side == "Sok" ? "active" : "")" aria-current="@(side == "Sok" ? "page" : null)" asp-controller="Sok" asp-action="Index">@T["Søk"]</a>
                            </li>
                        </ul>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main id="innhold" tabindex="-1">
        <div class="container">

            @* Meldinger fra controller, for eksempel «Ressursen er tildelt». *@
            @if (TempData["Melding"] is string melding)
            {
                <div class="alert alert-success mt-4" role="status">

                    <p class="mb-2">@melding</p>

                    @* Knappen vises bare etter registrering av et behov (settes i BehovController.Opprett). *@
                    @if (TempData["VisMineBehovKnapp"] != null)
                    {
                        <a asp-controller="Behov"
                           asp-action="MineBehov"
                           class="btn btn-primary mt-2">
                            @T["Se mine behov"]
                        </a>
                    }

                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="sidefot">
        <div class="container">
            <div class="fot-rutenett">
                <div>
                    <div class="fot-merke">
                        <span class="logo-icon logo-icon-small"><partial name="_Logo" /></span>
                        BeredskapsPortalen
                    </div>
                    <p>@T["En beredskapsportal som kobler behov under kriser med utstyr, kjøretøy og frivillige som kan stille opp."]</p>
                </div>
                <div>
                    <h2>@T["Sider"]</h2>
                    <ul>
                        <li><a asp-controller="Ressurs" asp-action="Index">@T["Ressurser og behov"]</a></li>
                        <li><a asp-controller="Behov" asp-action="Opprett">@T["Meld behov"]</a></li>
                        <li><a asp-controller="Ressurs" asp-action="Create">@T["Registrer en ressurs"]</a></li>
                        <li><a asp-controller="OnsketRessurs" asp-action="Index">@T["Ønskede ressurser"]</a></li>
                        @* Frivillige har ikke tilgang til Kommandobro, så lenken vises bare
                           for dem som ikke er logget inn og for Admin/Kommune. *@
                        @if (!Tilgang.ErInnlogget(User) || User.IsInRole("Admin") || User.IsInRole("Kommune"))
                        {
                            <li><a asp-controller="Kommandobro" asp-action="Index">@T["For nødetater og kriseledelse"]</a></li>
                        }
                    </ul>
                </div>
                <div>
                    <h2>@T["Om tjenesten"]</h2>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Sporsmal">@T["Spørsmål og svar"]</a></li>
                        <li><a asp-controller="Sok" asp-action="Index">@T["Søk"]</a></li>
                        <li><a asp-controller="Home" asp-action="Personvern">@T["Personvern"]</a></li>
                        <li><a asp-controller="Home" asp-action="Vilkar">@T["Vilkår for bruk"]</a></li>
                        <li><a asp-controller="Home" asp-action="Cookies">@T["Cookies"]</a></li>
                    </ul>
                </div>
            </div>
            <p class="fot-bunn">&copy; 2026 BeredskapsPortalen. @T["Studentprosjekt i IS-200, gruppe 15. BeredskapsPortalen erstatter ikke nødnumrene."]
                @T["Sist oppdatert:"] <time datetime="@Nettsted.SistOppdatert.ToString("yyyy-MM-dd")">@Nettsted.SistOppdatert.ToString("dd.MM.yyyy")</time></p>
        </div>
    </footer>

    <partial name="_CookieInfo" />

    <partial name="_JsTekster" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>