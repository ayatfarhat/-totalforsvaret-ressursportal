<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Sidetittel -->
    <title>@ViewData["Title"] - Nabohjelp</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Skrifttyper: Archivo til overskrifter, Schibsted Grotesk til tekst
         (norsk skrift, lett å lese, og 0 ligner ikke på Ø) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,600..800&family=Schibsted+Grotesk:wght@400;500;700&display=swap"
          rel="stylesheet">

    <!-- Prosjektets CSS - all stil for hele siden ligger her -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

@{
    // Hvilken side (controller) man er på, f.eks. "Home" eller "Ressurs".
    // Brukes for å markere riktig lenke i menyen.
    string aktivSide = "";
    if (ViewContext.RouteData.Values["controller"] is string controller)
    {
        aktivSide = controller;
    }
    bool erKoordinator = User.IsInRole("Admin") || User.IsInRole("Kommune");
}

<body>

    <header>

        <!-- Nødnumre. Lenkene ringer direkte når man trykker på mobil. -->
        <div class="nodstripe">
            <div class="container">
                <strong>Akutt fare for liv og helse?</strong>
                <span class="nodstripe-nummer">
                    <a href="tel:110">110 <span>brann</span></a>
                    <a href="tel:112">112 <span>politi</span></a>
                    <a href="tel:113">113 <span>ambulanse</span></a>
                </span>
            </div>
        </div>

        <!-- Toppmeny -->
        <nav class="navbar navbar-expand-lg toppmeny">
            <div class="container">

                <!-- Logo og lenke til forsiden -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="logo-icon logo-icon-small">
                        <partial name="_Logo" />
                    </span>
                    Nabohjelp
                </a>

                <!-- Mobilmeny -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#hovedmeny"
                        aria-controls="hovedmeny"
                        aria-expanded="false"
                        aria-label="Vis meny">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="hovedmeny">

                    <!-- Lenker for alle -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="@Visningstekst.MenyKlasse(aktivSide, "Home")"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                Forside
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Visningstekst.MenyKlasse(aktivSide, "Ressurs")"
                               asp-area="" asp-controller="Ressurs" asp-action="Index">
                                Ressurser
                            </a>
                        </li>
                    </ul>

                    <!-- Vises bare for Admin/Kommune -->
                    @if (erKoordinator)
                    {
                        <ul class="navbar-nav meny-koordinering">
                            <li class="nav-item">
                                <a class="@Visningstekst.MenyKlasse(aktivSide, "Kommandobro")"
                                   asp-area="" asp-controller="Kommandobro" asp-action="Index">
                                    Kommandobro
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Visningstekst.MenyKlasse(aktivSide, "Behov")"
                                   asp-area="" asp-controller="Behov" asp-action="Ko">
                                    Behovskø
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Visningstekst.MenyKlasse(aktivSide, "Tildeling")"
                                   asp-area="" asp-controller="Tildeling" asp-action="Index">
                                    Tildeling
                                </a>
                            </li>
                        </ul>
                    }

                    <!-- Innlogging / registrering -->
                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <!-- Hovedinnhold -->
    <main role="main" class="container">

        <!-- Viser meldinger sendt fra controller -->
        @if (TempData["Melding"] != null)
        {
            <div class="melding melding-ok toppmelding" role="status">
                @TempData["Melding"]
            </div>
        }

        @RenderBody()

    </main>

    <!-- Bunntekst -->
    <footer class="bunntekst">
        <div class="container">
            <span>Nabohjelp &ndash; naboer som hjelper hverandre i en krise.</span>
            <span>&copy; 2026 Gruppe 15</span>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
