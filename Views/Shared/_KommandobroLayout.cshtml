@{
    var kontroller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Aktiv(string navn) => string.Equals(navn, kontroller, StringComparison.OrdinalIgnoreCase) ? " active" : "";
    string? Gjeldende(string navn) => string.Equals(navn, kontroller, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0E1A24" />

    <title>@ViewData["Title"] - Kommandobro</title>

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preload" href="~/fonts/familjen-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    @* Kommandobro bruker samme CSS-fil som resten av siden. Den mørke stilen
       gjelder bare når <body> har klassen «kb» (se del 8 i site.css). *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="kb">

    <a class="hopp-lenke" href="#innhold">Hopp til innhold</a>

    <header>
        <div class="tilgangsvarsel">
            <p>Kun for nødetater, politi og kriseledelse. Ikke for privatpersoner.</p>
        </div>

        <nav class="navbar navbar-expand-md navbar-kommandobro" aria-label="Kommandobro-meny">
            <div class="container">
                <a class="navbar-brand" asp-controller="Kommandobro" asp-action="Index">
                    <span class="logo-icon logo-icon-small"><partial name="_Logo" /></span>
                    <span>Kommandobro <small>Nabohjelp</small></span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#kbmeny"
                        aria-controls="kbmeny"
                        aria-expanded="false"
                        aria-label="Åpne og lukk meny">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="kbmeny">
                    <ul class="navbar-nav ms-md-3">
                        <li class="nav-item">
                            <a class="nav-link@(Aktiv("Kommandobro"))" aria-current="@Gjeldende("Kommandobro")"
                               asp-controller="Kommandobro" asp-action="Index">Oversikt</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Behov" asp-action="Ko">Behovskø</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tildeling" asp-action="Index">Tildeling</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Til Nabohjelp</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-omriss btn-rad">Logg ut</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="innhold" tabindex="-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
