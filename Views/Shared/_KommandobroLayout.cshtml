<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kommandobro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Egen, mørk stil for Kommandobro. Helt separat fra _Layout.cshtml,
         siden Kommandobro og Nabohjelp bevisst skal se forskjellige ut
         (to ulike brukergrupper). Samme prinsipp som i _Layout.cshtml:
         farger definert én gang øverst i :root. -->
    <style>
        :root {
            --kb-bg: #0d1117;      /* nær-svart "ops-rom"-bakgrunn */
            --kb-panel: #161b22;
            --kb-border: #21262d;
            --kb-accent: #0f766e;  /* petrol/grønnlig aksentfarge */
            --kb-text: #e6edf3;
            --kb-radius: 10px;
        }

        body {
            background-color: var(--kb-bg);
            color: var(--kb-text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .navbar-kommandobro {
            background-color: var(--kb-panel) !important;
            border-bottom: 1px solid var(--kb-border);
        }

        .navbar-kommandobro .navbar-brand,
        .navbar-kommandobro .nav-link {
            color: var(--kb-text) !important;
        }

        .tilgangsvarsel {
            background-color: var(--kb-accent);
            color: #ffffff;
            text-align: center;
            padding: 8px;
            font-size: 0.9rem;
        }

        .kort-kommandobro {
            background-color: var(--kb-panel);
            border: 1px solid var(--kb-border);
            border-radius: var(--kb-radius);
        }
    </style>
</head>
<body>
    <header>
        <div class="tilgangsvarsel">
            For nødetater, politi og kriseledelse — ikke for privatpersoner.
        </div>
        <nav class="navbar navbar-expand-sm navbar-kommandobro mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Kommandobro" asp-action="Index">🛰️ Kommandobro</a>
                <a class="nav-link" asp-controller="Home" asp-action="Index">&larr; Tilbake til Nabohjelp</a>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
