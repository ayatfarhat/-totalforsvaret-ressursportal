@model RessursFormViewModel
@using Nabohjelp.Models

@* Felles skjema for «Registrer en ressurs» (Create) og «Endre ressurs» (Edit).
   Id = 0 betyr en ny ressurs. *@
@{
    bool erNy = Model.Id == 0;
}

<div class="skjema-rutenett">
    <form asp-action="@(erNy ? "Create" : "Edit")" asp-route-id="@(erNy ? "" : Model.Id.ToString())" method="post" class="skjema" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>
        <partial name="_Honningkrukke" />

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">1</span> @T["Hva kan du stille med?"]</legend>
            <div class="type-valg" role="presentation">
                @{ var typer = RessursFormViewModel.Typer; }
                @for (var i = 0; i < typer.Count; i++)
                {
                    <div class="type-valg-element">
                        <input type="radio" asp-for="Type" value="@typer[i]" id="type-@i" data-forslag="@RessursFormViewModel.HentForslag(typer[i])" />
                        @* Usynlig mellomrom etter «/» lar lange navn brytes pent på mobil *@
                        <label for="type-@i">@T[typer[i]].Value.Replace("/", "/\u200B")</label>
                    </div>
                }
            </div>
            <span asp-validation-for="Type"></span>

            @* Vises bare når «Annet» er valgt (se wwwroot/js/ressurs-skjema.js). *@
            <div class="felt mt-3" id="annet-felt" hidden>
                <label asp-for="AnnetType" class="form-label">@T["Hva slags ressurs?"]</label>
                <input asp-for="AnnetType" class="form-control" placeholder="@T["For eksempel vannpumpe, varmeovn eller tilhenger"]" />
                <span asp-validation-for="AnnetType"></span>
            </div>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">2</span> @T["Hvor finner vi det?"]</legend>

            <div class="felt">
                <label asp-for="KommuneNavn" class="form-label">@T["Kommune"]</label>
                <input asp-for="KommuneNavn" class="form-control" list="kommuneliste" autocomplete="off"
                       placeholder="@T["For eksempel Grimstad"]" aria-describedby="kommuneHjelp" />
                <partial name="_Kommuneliste" />
                <p id="kommuneHjelp" class="kart-tips">@T["Skriv kommunen, eller pek ut stedet på kartet under, så fyller vi inn kommune og adresse."]</p>
                <span asp-validation-for="KommuneNavn"></span>
            </div>

            <div class="felt">
                <label asp-for="Posisjon" class="form-label">@T["Adresse eller stedsnavn"]</label>
                <input asp-for="Posisjon" class="form-control" placeholder="@T["For eksempel Storgata 5, Kristiansand"]" autocomplete="street-address" />
                <span asp-validation-for="Posisjon"></span>
            </div>

            <div class="felt">
                <span class="form-label d-block">@T["Pek ut stedet på kartet"] <span class="valgfritt">@T["(valgfritt, men hjelper kriseledelsen)"]</span></span>
                <div id="ressursKart" class="kart-boks"
                     data-kartvelger
                     data-bredde="#breddegradInput"
                     data-lengde="#lengdegradInput"
                     data-status="#valgtPosisjon"
                     data-posisjon="#Posisjon"
                     data-kommune="#KommuneNavn"
                     data-knapp="#minPosisjon"
                     data-nal="gi"
                     role="group" aria-label="@T["Kart. Trykk for å velge posisjon."]"></div>
                <div class="kart-rad">
                    <button type="button" id="minPosisjon" class="btn btn-outline-secondary btn-sm">@T["Bruk min posisjon"]</button>
                    <p id="valgtPosisjon" class="valgt" aria-live="polite">@T["Ingen posisjon valgt ennå."]</p>
                </div>
                <p class="kart-tips">@T["Trykk på kartet for å sette en nål. Du kan dra nålen for å justere."]</p>

                <input asp-for="Breddegrad" type="hidden" id="breddegradInput" />
                <input asp-for="Lengdegrad" type="hidden" id="lengdegradInput" />
            </div>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">3</span> @T["Når og hvordan kan vi nå deg?"]</legend>

            <div class="felt">
                <label asp-for="TilgjengeligFra" class="form-label">@T["Tilgjengelig fra"]</label>
                <input asp-for="TilgjengeligFra" class="form-control" type="datetime-local" />
                <span asp-validation-for="TilgjengeligFra"></span>
            </div>

            <div class="felt">
                <label asp-for="Beskrivelse" class="form-label">@T["Beskrivelse"]</label>
                <textarea asp-for="Beskrivelse" class="form-control" rows="4" placeholder="@T["For eksempel størrelse, tilstand eller hvor mange timer du kan hjelpe"]"></textarea>
                <p class="kart-tips">@T["Når du velger type, fyller vi inn et forslag du kan endre."]</p>
                <span asp-validation-for="Beskrivelse"></span>
            </div>

            <div class="felt">
                @if (!erNy && !string.IsNullOrEmpty(Model.BildeSti))
                {
                    <span class="form-label d-block">@T["Nåværende bilde"]</span>
                    <img src="@Model.BildeSti" class="ressurs-bilde" alt="@T["Nåværende bilde av ressursen: {0}", Model.VisType()]" />
                    <div class="form-check mt-2 mb-3">
                        <input asp-for="FjernBilde" class="form-check-input" type="checkbox" />
                        <label asp-for="FjernBilde" class="form-check-label">@T["Fjern bildet"]</label>
                    </div>
                }
                <label for="bildefil" class="form-label">@(erNy || string.IsNullOrEmpty(Model.BildeSti) ? T["Bilde av ressursen"] : T["Bytt bilde"]) <span class="valgfritt">@T["(valgfritt)"]</span></label>
                <input type="file" name="bildefil" id="bildefil" class="form-control" accept="image/jpeg,image/png,image/webp" aria-describedby="bildeHjelp" />
                <p id="bildeHjelp" class="kart-tips">@T["JPG, PNG eller WebP, maks 5 MB. Hvis skjemaet vises på nytt med feil, må du velge bildet igjen."]</p>
                @Html.ValidationMessage("Bilde")
                <p id="bildeFeil" class="field-validation-error" role="alert" hidden></p>
                <img id="bildeForhandsvisning" class="ressurs-bilde" alt="@T["Forhåndsvisning av valgt bilde"]" hidden />
            </div>

            <div class="felt-par">
                <div class="felt">
                    <label asp-for="Navn" class="form-label">@T["Navn på kontaktperson"]</label>
                    <input asp-for="Navn" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Navn"></span>
                </div>
                <div class="felt">
                    <label asp-for="Telefon" class="form-label">@T["Telefon"]</label>
                    <div class="telefon-rad">
                        <select asp-for="Landskode" class="form-select" aria-label="@T["Landskode"]">
                            @foreach (Land land in Land.Alle)
                            {
                                <option value="@land.Kode">@land.Kode @T[land.Navn]</option>
                            }
                        </select>
                        <input asp-for="Telefon" class="form-control" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="12345678" />
                    </div>
                    <span asp-validation-for="Landskode"></span>
                    <span asp-validation-for="Telefon"></span>
                </div>
            </div>
        </fieldset>

        <div class="skjema-bunn">
            <button type="submit" class="btn btn-success btn-lg">@(erNy ? T["Send inn"] : T["Lagre endringer"])</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">@T["Avbryt"]</a>
        </div>
    </form>

    <aside class="sidepanel" aria-labelledby="panel-tittel">
        @if (erNy)
        {
            <h2 id="panel-tittel">@T["Hva skjer videre?"]</h2>
            <ol>
                <li>@T["Ressursen får status «Tilgjengelig»."]</li>
                <li>@T["Den vises på kartet til kriseledelsen."]</li>
                <li>@T["Kriseledelsen kan koble den til et behov i nærheten."]</li>
            </ol>
            <p>@T["Trenger du selv hjelp?"] <a asp-controller="Behov" asp-action="Opprett">@T["Meld et behov"]</a>.</p>
        }
        else
        {
            <h2 id="panel-tittel">@T["Om endringene"]</h2>
            <ul>
                <li>@T["Endringene vises med en gang for kriseledelsen."]</li>
                <li>@T["Statusen («{0}») endres ikke her. Den styres av tildelingen.", T[Model.Status]]</li>
            </ul>
            <p>@T["Har du ikke ressursen lenger?"] <a asp-action="Delete" asp-route-id="@Model.Id">@T["Slett ressursen"]</a>.</p>
        }
    </aside>
</div>
