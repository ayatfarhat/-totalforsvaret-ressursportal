@model Nabohjelp.ViewModels.RessursUtskriftViewModel
@* Ressurslisten per fylke og kommune, laget for utskrift. Utvalget og grupperingen
   gjøres i RessursUtskriftViewModel.Lag, siden viser bare resultatet. *@

@{
    ViewData["Title"] = T["Ressursliste per kommune"];
    string? forrigeFylke = null;
}

<div class="side-topp utskrift-skjul">
    <h1>@T["Ressursliste per kommune"]</h1>
    <p class="ingress">@T["Velg fylke eller kommune, og skriv ut listen eller lagre den som PDF. Listen viser alle registrerte ressurser, også de som er tildelt."]</p>
</div>

<form method="get" asp-action="Utskrift" class="utskrift-filter utskrift-skjul">
    <div class="felt">
        <label for="fylke" class="form-label">@T["Fylke"]</label>
        <select id="fylke" name="fylke" class="form-select">
            <option value="">@T["Alle fylker"]</option>
            @foreach (string fylke in Kommuner.Fylker)
            {
                <option value="@fylke" selected="@(fylke == Model.ValgtFylke && Model.ValgtKommune == null)">@fylke</option>
            }
        </select>
    </div>
    <div class="felt">
        <label for="kommune" class="form-label">@T["Kommune"] <span class="valgfritt">@T["(går foran fylket)"]</span></label>
        <select id="kommune" name="kommune" class="form-select">
            <option value="">@T["Alle kommuner"]</option>
            @foreach (string fylke in Kommuner.Fylker)
            {
                <optgroup label="@fylke">
                    @foreach (Kommune kommune in Kommuner.IFylke(fylke))
                    {
                        <option value="@kommune.Nummer" selected="@(kommune.Nummer == Model.ValgtKommune)">@kommune.Navn</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="utskrift-knapper">
        <button type="submit" class="btn btn-outline-secondary">@T["Vis liste"]</button>
        <button type="button" id="skrivUt" class="btn btn-success">@T["Skriv ut"]</button>
    </div>
</form>

<section class="utskrift" aria-labelledby="utskrift-tittel">
    <div class="utskrift-hode">
        <h2 id="utskrift-tittel">@T["Ressurser"]: @Model.VisOmrade()</h2>
        <p>@T["BeredskapsPortalen, laget {0}.", Model.Laget.ToString("dd.MM.yyyy HH:mm")] @T[Model.Antall == 1 ? "1 ressurs" : "{0} ressurser", Model.Antall] @T["fordelt på"] @T[Model.Grupper.Count == 1 ? "1 kommune." : "{0} kommuner.", Model.Grupper.Count]</p>
    </div>

    @if (Model.Grupper.Count == 0)
    {
        <div class="tom-tilstand">
            <h3>@T["Ingen ressurser i {0}", Model.VisOmrade()]</h3>
            <p>@T["Velg et annet fylke eller en annen kommune, eller vis hele landet."]</p>
            <a class="btn btn-outline-secondary" asp-action="Utskrift">@T["Vis hele landet"]</a>
        </div>
    }

    @foreach (var gruppe in Model.Grupper)
    {
        @if (gruppe.Fylke != forrigeFylke && !string.IsNullOrEmpty(gruppe.Fylke))
        {
            <h3 class="utskrift-fylke">@gruppe.Fylke</h3>
        }
        forrigeFylke = gruppe.Fylke;

        <section class="kommune-gruppe" aria-label="@gruppe.Kommune">
            <h4>@gruppe.Kommune <span class="antall">@gruppe.Ressurser.Count</span></h4>
            <div class="table-responsive">
            <table class="table utskrift-tabell">
                <thead>
                    <tr>
                        <th scope="col">@T["Type"]</th>
                        <th scope="col">@T["Adresse"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col">@T["Tilgjengelig fra"]</th>
                        <th scope="col">@T["Kontakt"]</th>
                        <th scope="col">@T["Beskrivelse"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ressurs in gruppe.Ressurser)
                    {
                        <tr>
                            <td><strong>@ressurs.VisType()</strong></td>
                            <td>@ressurs.Posisjon</td>
                            <td>@T[ressurs.Status]</td>
                            <td>@ressurs.VisTilgjengeligFra()</td>
                            <td>
                                @ressurs.VisNavn()<br />
                                @ressurs.VisTelefon()
                            </td>
                            <td><span class="tekst-linjer">@ressurs.VisBeskrivelse()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </section>
    }
</section>

@section Scripts {
    <script>
        // «Skriv ut» åpner nettleserens utskrift. Der kan listen også lagres som PDF.
        document.getElementById("skrivUt").addEventListener("click", function () {
            window.print();
        });
    </script>
}
