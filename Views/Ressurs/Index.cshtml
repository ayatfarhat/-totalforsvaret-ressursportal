@model List<Nabohjelp.Models.RessursFormViewModel>

@{
    ViewData["Title"] = "Ressurser";
}

<div class="sidetopp sidetopp-rad">
    <div>
        <h1>Registrerte ressurser</h1>
        <p class="ingress">Utstyr, kjøretøy, lokaler og frivillige som naboer har meldt inn.</p>
    </div>
    <a class="btn btn-success" asp-action="Create">Registrer en ressurs</a>
</div>

@if (!Model.Any())
{
    <div class="tom-liste">
        <p>Ingen ressurser er registrert ennå.</p>
        <p><a class="btn btn-success" asp-action="Create">Registrer den første</a></p>
    </div>
}
else
{
    <div class="tabell-ramme">
        <table class="tabell">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Posisjon</th>
                    <th>Tilgjengelig fra</th>
                    <th>Status</th>
                    <th>Kontakt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ressurs in Model)
                {
                    <tr>
                        <td class="sterk">@ressurs.Type</td>
                        <td>@ressurs.Posisjon</td>
                        <td>@ressurs.VisTilgjengeligFra()</td>
                        <td>
                            <span class="merke @Visningstekst.RessursStatusFarge(ressurs.Status)">@ressurs.Status</span>
                        </td>
                        <td>@ressurs.Navn @ressurs.Telefon</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
