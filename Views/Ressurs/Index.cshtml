@model List<RessursFormViewModel>

@{
    ViewData["Title"] = T["Ressurser og behov"];
    bool erInnlogget = Tilgang.ErInnlogget(User);

    // Controlleren gir Admin og Kommune alle ressurser, og frivillige bare
    // sine egne. Derfor kan adresse og kontaktinfo vises for alt i lista.
    bool erKoordinator = ViewBag.ErKoordinator is bool k && k;
}

<div class="side-topp">
    <h1>@T["Ressurser og behov"]</h1>
    <p class="ingress">@T["Trenger du hjelp, eller kan du bidra? Velg riktig spor."]</p>
</div>

<div class="spor">
    <section class="spor-kort spor-hjelp" aria-labelledby="spor-hjelp-tittel">
        <h2 id="spor-hjelp-tittel">@T["Jeg trenger hjelp"]</h2>
        <p>@T["Meld et behov i ditt område, for eksempel transport, strøm eller evakuering."]</p>
        <a class="btn btn-danger" asp-controller="Behov" asp-action="Opprett">@T["Meld behov"]</a>
        @if (!erInnlogget)
        {
            <small class="dempet">@T["Du må logge inn først."]</small>
        }
    </section>

    <section class="spor-kort spor-gi" aria-labelledby="spor-gi-tittel">
        <h2 id="spor-gi-tittel">@T["Jeg kan hjelpe"]</h2>
        <p>@T["Registrer utstyr, kjøretøy, lokaler eller innsats du kan stille til rådighet."]</p>
        <a class="btn btn-success" asp-action="Create">@T["Registrer en ressurs"]</a>
    </section>
</div>

<section class="spor-kort onsket-boks" aria-labelledby="onsket-tittel">
    <h2 id="onsket-tittel">@T["Ønskede ressurser"]</h2>
    <p>
        @if ((int)ViewBag.AntallOnskede > 0)
        {
            int antallOnskede = (int)ViewBag.AntallOnskede;
            <text>@T["Kommunen og kriseledelsen har akkurat nå"] <strong>@antallOnskede</strong> @(antallOnskede == 1 ? T["ønske"] : T["ønsker"]). @T["Se om du kan stille med noe."]</text>
        }
        else
        {
            <text>@T["Her ser du hva kommunen og kriseledelsen ønsker at innbyggere registrerer."]</text>
        }
    </p>
    <a class="btn btn-outline-secondary" asp-controller="OnsketRessurs" asp-action="Index">@T["Se ønskede ressurser"]</a>
</section>

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

<section aria-labelledby="liste-tittel">
    <div class="liste-topp">
        <h2 id="liste-tittel">@(erKoordinator ? T["Registrerte ressurser"] : T["Dine ressurser"])</h2>
        @if (Model.Count > 0)
        {
            <span class="antall">@Model.Count</span>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="tom-tilstand">
            <h3>@T["Ingen ressurser er registrert ennå"]</h3>
            <p>@T["Den første ressursen du legger inn, vises her og på kartet til kriseledelsen."]</p>
            <a class="btn btn-success" asp-action="Create">@T["Registrer en ressurs"]</a>
        </div>
    }
    else
    {
        @if (!erKoordinator)
        {
            <p class="kart-tips">@T["Her ser du ressursene du selv har registrert. Du kan endre eller slette dem. Kommunen og kriseledelsen ser alle."]</p>
        }
        else
        {
            <div class="liste-handling">
                <a class="btn btn-outline-secondary" asp-action="Utskrift">@T["Skriv ut ressursliste per kommune"]</a>
            </div>
        }
        <div class="table-responsive">
            <table class="table stablet align-middle">
                <thead>
                    <tr>
                        <th scope="col">@T["Type"]</th>
                        <th scope="col">@T["Kommune"]</th>
                        <th scope="col">@T["Posisjon"]</th>
                        <th scope="col">@T["Tilgjengelig fra"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col">@T["Kontakt"]</th>
                        <th scope="col"><span class="visually-hidden">@T["Handling"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ressurs in Model)
                    {
                        <tr>
                            <td data-label="@T["Type"]">
                                <span class="type-med-bilde">
                                    @if (!string.IsNullOrEmpty(ressurs.BildeSti))
                                    {
                                        <img src="@ressurs.BildeSti" class="ressurs-miniatyr" alt="@T["Bilde av {0}", T[ressurs.Type]]" loading="lazy" />
                                    }
                                    <strong>@T[ressurs.Type]</strong>
                                </span>
                            </td>
                            <td data-label="@T["Kommune"]">@ressurs.VisKommune()</td>
                            <td data-label="@T["Posisjon"]">@ressurs.Posisjon</td>
                            <td data-label="@T["Tilgjengelig fra"]">@ressurs.VisTilgjengeligFra()</td>
                            <td data-label="@T["Status"]">
                                <span class="merke @Visningstekst.RessursStatusFarge(ressurs.Status)">@T[ressurs.Status]</span>
                            </td>
                            <td data-label="@T["Kontakt"]">
                                @ressurs.Navn
                                @if (!string.IsNullOrWhiteSpace(ressurs.Telefon))
                                {
                                    <a href="tel:@ressurs.TelefonLenke()">@ressurs.VisTelefon()</a>
                                }
                            </td>
                            @* Lista viser bare ressurser brukeren kan endre: egne, eller alle for Kommune og Admin. *@
                            <td data-label="" class="ressurs-handling">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@ressurs.Id" aria-label="@T["Endre {0}, {1}", T[ressurs.Type], ressurs.Posisjon]">@T["Endre"]</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@ressurs.Id" aria-label="@T["Slett {0}, {1}", T[ressurs.Type], ressurs.Posisjon]">@T["Slett"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
