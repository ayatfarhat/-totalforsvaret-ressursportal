@model List<Kriseportal.Models.RessursFormViewModel>

@{
    ViewData["Title"] = "Ressurser";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1>Nabohjelp</h1>
            <p class="lead">Trenger du hjelp, eller kan du bidra med en ressurs?</p>
        </div>
    </div>

    <div class="row justify-content-center g-3 mb-5">
        <div class="col-12 col-md-5">
            <div class="card border-danger h-100">
                <div class="card-body text-center">
                    <h3 class="card-title text-danger">Jeg trenger hjelp</h3>
                    <p class="card-text">Meld inn et behov i ditt område.</p>
                    <a class="btn btn-danger" href="#">Meld behov</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-5">
            <div class="card border-success h-100">
                <div class="card-body text-center">
                    <h3 class="card-title text-success">Jeg kan hjelpe</h3>
                    <p class="card-text">Registrer en ressurs du kan stille til rådighet.</p>
                    <a class="btn btn-success" asp-action="Create">Registrer en ressurs</a>
                </div>
            </div>
        </div>
    </div>

    <h2>Registrerte ressurser</h2>

    @if (!Model.Any())
    {
        <p>Ingen ressurser er registrert ennå.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Posisjon</th>
                        <th>Tilgjengelig fra</th>
                        <th>Status</th>
                        <th>Kontakt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ressurs in Model)
                    {
                        <tr>
                            <td>@ressurs.Type</td>
                            <td>@ressurs.Posisjon</td>
                            <td>@ressurs.VisTilgjengeligFra()</td>
                            <td>@ressurs.Status</td>
                            <td>@ressurs.Navn @ressurs.Telefon</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
