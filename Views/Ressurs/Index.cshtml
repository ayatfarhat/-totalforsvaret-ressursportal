@model List<RessursFormViewModel>

@{
    ViewData["Title"] = "Ressurser og behov";
    bool erInnlogget = User.Identity?.IsAuthenticated == true;

    // Controlleren gir Admin og Kommune alle ressurser, og frivillige bare
    // sine egne. Derfor kan adresse og kontaktinfo vises for alt i lista.
    bool erKoordinator = ViewBag.ErKoordinator is bool k && k;
}

<div class="side-topp">
    <h1>Ressurser og behov</h1>
    <p class="ingress">Trenger du hjelp, eller kan du bidra? Velg riktig spor.</p>
</div>

<div class="spor">
    <section class="spor-kort spor-hjelp" aria-labelledby="spor-hjelp-tittel">
        <h2 id="spor-hjelp-tittel">Jeg trenger hjelp</h2>
        <p>Meld et behov i ditt område, for eksempel transport, strøm eller evakuering.</p>
        <a class="btn btn-danger" asp-controller="Behov" asp-action="Opprett">Meld behov</a>
        @if (!erInnlogget)
        {
            <small class="dempet">Du må logge inn først.</small>
        }
    </section>

    <section class="spor-kort spor-gi" aria-labelledby="spor-gi-tittel">
        <h2 id="spor-gi-tittel">Jeg kan hjelpe</h2>
        <p>Registrer utstyr, kjøretøy, lokaler eller innsats du kan stille til rådighet.</p>
        <a class="btn btn-success" asp-action="Create">Registrer en ressurs</a>
    </section>
</div>

<section class="spor-kort onsket-boks" aria-labelledby="onsket-tittel">
    <h2 id="onsket-tittel">Ønskede ressurser</h2>
    <p>
        @if ((int)ViewBag.AntallOnskede > 0)
        {
            int antallOnskede = (int)ViewBag.AntallOnskede;
            <text>Kommunen og kriseledelsen har akkurat nå <strong>@antallOnskede</strong> @(antallOnskede == 1 ? "ønske" : "ønsker"). Se om du kan stille med noe.</text>
        }
        else
        {
            <text>Her ser du hva kommunen og kriseledelsen ønsker at innbyggere registrerer.</text>
        }
    </p>
    <a class="btn btn-outline-secondary" asp-controller="OnsketRessurs" asp-action="Index">Se ønskede ressurser</a>
</section>

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

<section aria-labelledby="liste-tittel">
    <div class="liste-topp">
        <h2 id="liste-tittel">@(erKoordinator ? "Registrerte ressurser" : "Dine ressurser")</h2>
        @if (Model.Any())
        {
            <span class="antall">@Model.Count</span>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="tom-tilstand">
            <h3>Ingen ressurser er registrert ennå</h3>
            <p>Den første ressursen du legger inn, vises her og på kartet til kriseledelsen.</p>
            <a class="btn btn-success" asp-action="Create">Registrer en ressurs</a>
        </div>
    }
    else
    {
        @if (!erKoordinator)
        {
            <p class="kart-tips">Her ser du ressursene du selv har registrert. Du kan endre eller slette dem. Kommunen og kriseledelsen ser alle.</p>
        }
        else
        {
            <div class="liste-handling">
                <a class="btn btn-outline-secondary" asp-action="Utskrift">Skriv ut ressursliste per kommune</a>
            </div>
        }
        <div class="table-responsive">
            <table class="table stablet align-middle">
                <thead>
                    <tr>
                        <th scope="col">Type</th>
                        <th scope="col">Kommune</th>
                        <th scope="col">Posisjon</th>
                        <th scope="col">Tilgjengelig fra</th>
                        <th scope="col">Status</th>
                        <th scope="col">Kontakt</th>
                        <th scope="col"><span class="visually-hidden">Handling</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ressurs in Model)
                    {
                        <tr>
                            <td data-label="Type">
                                <span class="type-med-bilde">
                                    @if (!string.IsNullOrEmpty(ressurs.BildeSti))
                                    {
                                        <img src="@ressurs.BildeSti" class="ressurs-miniatyr" alt="Bilde av @ressurs.Type" loading="lazy" />
                                    }
                                    <strong>@ressurs.Type</strong>
                                </span>
                            </td>
                            <td data-label="Kommune">@ressurs.VisKommune()</td>
                            <td data-label="Posisjon">@ressurs.Posisjon</td>
                            <td data-label="Tilgjengelig fra">@ressurs.VisTilgjengeligFra()</td>
                            <td data-label="Status">
                                <span class="merke @Visningstekst.RessursStatusFarge(ressurs.Status)">@ressurs.Status</span>
                            </td>
                            <td data-label="Kontakt">
                                @ressurs.Navn
                                @if (!string.IsNullOrWhiteSpace(ressurs.Telefon))
                                {
                                    <a href="tel:@ressurs.TelefonLenke()">@ressurs.VisTelefon()</a>
                                }
                            </td>
                            @* Lista viser bare ressurser brukeren kan endre: egne, eller alle for Kommune og Admin. *@
                            <td data-label="" class="ressurs-handling">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@ressurs.Id" aria-label="Endre @ressurs.Type, @ressurs.Posisjon">Endre</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@ressurs.Id" aria-label="Slett @ressurs.Type, @ressurs.Posisjon">Slett</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
