@model List<Nabohjelp.Models.RessursFormViewModel>

@{
    ViewData["Title"] = "Nabohjelp";
    bool erInnlogget = User.Identity?.IsAuthenticated == true;
}

<div class="side-topp">
    <h1>Nabohjelp</h1>
    <p class="ingress">Trenger du hjelp, eller kan du bidra? Velg riktig spor.</p>
</div>

<div class="spor">
    <section class="spor-kort spor-hjelp" aria-labelledby="spor-hjelp-tittel">
        <h2 id="spor-hjelp-tittel">Jeg trenger hjelp</h2>
        <p>Meld et behov i ditt område, for eksempel transport, strøm eller evakuering.</p>
        <a class="btn btn-danger" asp-controller="Behov" asp-action="Opprett">Meld behov</a>
        @if (!erInnlogget)
        {
            <small class="dempet">Du må logge inn først.</small>
        }
    </section>

    <section class="spor-kort spor-gi" aria-labelledby="spor-gi-tittel">
        <h2 id="spor-gi-tittel">Jeg kan hjelpe</h2>
        <p>Registrer utstyr, kjøretøy, lokaler eller innsats du kan stille til rådighet.</p>
        <a class="btn btn-success" asp-action="Create">Registrer en ressurs</a>
    </section>
</div>

<section aria-labelledby="liste-tittel">
    <div class="liste-topp">
        <h2 id="liste-tittel">Registrerte ressurser</h2>
        @if (Model.Any())
        {
            <span class="antall">@Model.Count</span>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="tom-tilstand">
            <h3>Ingen ressurser er registrert ennå</h3>
            <p>Den første ressursen du legger inn, vises her og på kartet til kriseledelsen.</p>
            <a class="btn btn-success" asp-action="Create">Registrer en ressurs</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table stablet align-middle">
                <thead>
                    <tr>
                        <th scope="col">Type</th>
                        <th scope="col">Posisjon</th>
                        <th scope="col">Tilgjengelig fra</th>
                        <th scope="col">Status</th>
                        <th scope="col">Kontakt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ressurs in Model)
                    {
                        <tr>
                            <td data-label="Type"><strong>@ressurs.Type</strong></td>
                            <td data-label="Posisjon">@ressurs.Posisjon</td>
                            <td data-label="Tilgjengelig fra">@ressurs.VisTilgjengeligFra()</td>
                            <td data-label="Status">
                                <span class="merke @(ressurs.Status == "Tilgjengelig" ? "merke-gi" : "")">@ressurs.Status</span>
                            </td>
                            <td data-label="Kontakt">
                                @ressurs.Navn
                                @if (!string.IsNullOrWhiteSpace(ressurs.Telefon))
                                {
                                    <a href="tel:@ressurs.Telefon">@ressurs.Telefon</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
