@model Nabohjelp.Models.RessursFormViewModel

@{
    ViewData["Title"] = "Kvittering";
    bool harPosisjon = Model.Breddegrad != null && Model.Lengdegrad != null;
}

@if (harPosisjon)
{
    <!-- Leaflet-kart, bare lastet inn hvis en posisjon faktisk ble valgt -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="skjema-side">
    <div class="sidetopp">
        <div class="bekreftelse-ikon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </div>
        <h1>Takk, ressursen er registrert</h1>
        <p class="ingress">Ressursen står nå på listen, og kriseledelsen kan tildele den der den trengs.</p>
    </div>

    <div class="panel">
        <h2>Kvittering</h2>
        <dl class="opplysninger">
            <dt>Type</dt>
            <dd>@Model.Type</dd>

            <dt>Posisjon</dt>
            <dd>@Model.Posisjon</dd>

            <dt>Koordinater</dt>
            <dd>@Model.VisKoordinater()</dd>

            <dt>Tilgjengelig fra</dt>
            <dd>@Model.VisTilgjengeligFra()</dd>

            <dt>Beskrivelse</dt>
            <dd>@Model.VisBeskrivelse()</dd>

            <dt>Navn</dt>
            <dd>@Model.VisNavn()</dd>

            <dt>Telefon</dt>
            <dd>@Model.VisTelefon()</dd>

            <dt>Status</dt>
            <dd><span class="merke @Visningstekst.RessursStatusFarge(Model.Status)">@Model.Status</span></dd>
        </dl>

        @if (harPosisjon)
        {
            <!-- Lite kart som viser hvor posisjonen ble valgt -->
            <div id="kvitteringKart" class="kart kart-lav mt-3"></div>
        }
    </div>

    <div class="knapperad mt-4">
        <a asp-action="Create" class="btn btn-success">Registrer en ressurs til</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Til forsiden</a>
    </div>
</div>

@section Scripts {
    @if (harPosisjon)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            // Viser et lite kart med en markør der brukeren valgte posisjon
            const breddegrad = @Model.Breddegrad!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const lengdegrad = @Model.Lengdegrad!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

            const kart = L.map('kvitteringKart').setView([breddegrad, lengdegrad], 13);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(kart);

            L.marker([breddegrad, lengdegrad]).addTo(kart);
        </script>
    }
}
