@model Nabohjelp.Models.RessursFormViewModel

@{
    ViewData["Title"] = "Kvittering";
    bool harPosisjon = Model.Breddegrad != null && Model.Lengdegrad != null;
}

@if (harPosisjon)
{
    <!-- Leaflet-kart, bare lastet inn hvis en posisjon faktisk ble valgt -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 text-center">
            <h1 class="text-success">Takk for din registrering!</h1>
            <p class="lead">Ressursen din er nå registrert og synlig for koordinatorer.</p>
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <div class="col-12 col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Sammendrag</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">@Model.Type</dd>

                        <dt class="col-sm-4">Posisjon</dt>
                        <dd class="col-sm-8">@Model.Posisjon</dd>

                        <dt class="col-sm-4">Koordinater</dt>
                        <dd class="col-sm-8">@Model.VisKoordinater()</dd>

                        <dt class="col-sm-4">Tilgjengelig fra</dt>
                        <dd class="col-sm-8">@Model.VisTilgjengeligFra()</dd>

                        <dt class="col-sm-4">Beskrivelse</dt>
                        <dd class="col-sm-8">@Model.VisBeskrivelse()</dd>

                        <dt class="col-sm-4">Navn</dt>
                        <dd class="col-sm-8">@Model.VisNavn()</dd>

                        <dt class="col-sm-4">Telefon</dt>
                        <dd class="col-sm-8">@Model.VisTelefon()</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>
                </div>
            </div>

            @if (harPosisjon)
            {
                <!-- Lite kart som viser hvor posisjonen ble valgt -->
                <div id="kvitteringKart" class="mt-3" style="height: 250px; width: 100%; border-radius: var(--nh-radius);"></div>
            }

            <div class="text-center mt-4">
                <a asp-action="Create" class="btn btn-success">Send en ny melding</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Til forsiden</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (harPosisjon)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            // Viser et lite kart med en markør der brukeren valgte posisjon
            const breddegrad = @Model.Breddegrad.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const lengdegrad = @Model.Lengdegrad.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

            const kart = L.map('kvitteringKart').setView([breddegrad, lengdegrad], 13);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(kart);

            L.marker([breddegrad, lengdegrad]).addTo(kart);
        </script>
    }
}
