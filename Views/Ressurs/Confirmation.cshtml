@model Nabohjelp.Models.RessursFormViewModel

@{
    ViewData["Title"] = "Kvittering";
    bool harPosisjon = Model.Breddegrad != null && Model.Lengdegrad != null;
}

@section Head {
    @if (harPosisjon)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }
}

<div class="kvittering">
    <div class="kvittering-topp">
        <svg class="hake" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
            <circle cx="36" cy="36" r="34" fill="#E4F1EA" stroke="#1B6B4B" stroke-width="3" />
            <path d="M21 37l10 10 20-22" fill="none" stroke="#1B6B4B" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h1>Takk, ressursen er registrert</h1>
        <p>Den er nå synlig for kriseledelsen og kan kobles til et behov.</p>
    </div>

    <section class="sammendrag-boks" aria-labelledby="sammendrag-tittel">
        <h2 id="sammendrag-tittel">Sammendrag</h2>
        <dl class="sammendrag">
            <div><dt>Type</dt><dd>@Model.Type</dd></div>
            <div><dt>Posisjon</dt><dd>@Model.Posisjon</dd></div>
            <div><dt>Koordinater</dt><dd>@Model.VisKoordinater()</dd></div>
            <div><dt>Tilgjengelig fra</dt><dd>@Model.VisTilgjengeligFra()</dd></div>
            <div><dt>Beskrivelse</dt><dd>@Model.VisBeskrivelse()</dd></div>
            <div><dt>Navn</dt><dd>@Model.VisNavn()</dd></div>
            <div><dt>Telefon</dt><dd>@Model.VisTelefon()</dd></div>
            <div><dt>Status</dt><dd><span class="merke merke-gi">@Model.Status</span></dd></div>
        </dl>
    </section>

    @if (harPosisjon)
    {
        <div id="kvitteringKart" class="kart-boks"
             data-kartvisning
             data-bredde="@Model.Breddegrad!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-lengde="@Model.Lengdegrad!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-nal="gi"
             role="img"
             aria-label="Kart som viser posisjonen du valgte"></div>
    }

    <div class="kvittering-handling">
        <a asp-action="Create" class="btn btn-success">Registrer en til</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Se alle ressurser</a>
    </div>
</div>

@section Scripts {
    @if (harPosisjon)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="~/js/kart.js" asp-append-version="true"></script>
    }
}
