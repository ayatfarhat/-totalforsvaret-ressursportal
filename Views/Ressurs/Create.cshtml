@model Nabohjelp.Models.RessursFormViewModel

@{
    ViewData["Title"] = "Registrer en ressurs";
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="side-topp">
    <h1>Registrer en ressurs</h1>
    <p class="ingress">Fortell hva du kan stille med og hvor det finnes. Type og posisjon må fylles ut, resten er valgfritt.</p>
</div>

<div class="skjema-rutenett">
    <form asp-action="Create" method="post" class="skjema" novalidate>
        <div asp-validation-summary="ModelOnly" class="feiloversikt" role="alert"></div>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">1</span> Hva kan du stille med?</legend>
            <div class="type-valg" role="presentation">
                @{ var typer = Nabohjelp.Models.RessursFormViewModel.Typer; }
                @for (var i = 0; i < typer.Count; i++)
                {
                    <div class="type-valg-element">
                        <input type="radio" asp-for="Type" value="@typer[i]" id="type-@i" />
                        <label for="type-@i">@typer[i]</label>
                    </div>
                }
            </div>
            <span asp-validation-for="Type"></span>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">2</span> Hvor finner vi det?</legend>

            <div class="felt">
                <label asp-for="Posisjon" class="form-label">Adresse eller stedsnavn</label>
                <input asp-for="Posisjon" class="form-control" placeholder="For eksempel Storgata 5, Kristiansand" autocomplete="street-address" />
                <span asp-validation-for="Posisjon"></span>
            </div>

            <div class="felt">
                <span class="form-label d-block">Pek ut stedet på kartet <span class="valgfritt">(valgfritt, men hjelper kriseledelsen)</span></span>
                <div id="ressursKart" class="kart-boks"
                     data-kartvelger
                     data-bredde="#breddegradInput"
                     data-lengde="#lengdegradInput"
                     data-status="#valgtPosisjon"
                     data-posisjon="#Posisjon"
                     data-knapp="#minPosisjon"
                     data-nal="gi"
                     role="group" aria-label="Kart. Trykk for å velge posisjon."></div>
                <div class="kart-rad">
                    <button type="button" id="minPosisjon" class="btn btn-outline-secondary btn-sm">Bruk min posisjon</button>
                    <p id="valgtPosisjon" class="valgt" aria-live="polite">Ingen posisjon valgt ennå.</p>
                </div>
                <p class="kart-tips">Trykk på kartet for å sette en nål. Du kan dra nålen for å justere.</p>

                <input asp-for="Breddegrad" type="hidden" id="breddegradInput" />
                <input asp-for="Lengdegrad" type="hidden" id="lengdegradInput" />
            </div>
        </fieldset>

        <fieldset class="felt-gruppe">
            <legend><span class="trinn" aria-hidden="true">3</span> Når og hvordan kan vi nå deg?</legend>

            <div class="felt">
                <label asp-for="TilgjengeligFra" class="form-label">Tilgjengelig fra <span class="valgfritt">(valgfritt)</span></label>
                <input asp-for="TilgjengeligFra" class="form-control" type="datetime-local" />
                <span asp-validation-for="TilgjengeligFra"></span>
            </div>

            <div class="felt">
                <label asp-for="Beskrivelse" class="form-label">Beskrivelse <span class="valgfritt">(valgfritt)</span></label>
                <textarea asp-for="Beskrivelse" class="form-control" rows="3" placeholder="For eksempel størrelse, tilstand eller hvor mange timer du kan hjelpe"></textarea>
                <span asp-validation-for="Beskrivelse"></span>
            </div>

            <div class="felt-par">
                <div class="felt">
                    <label asp-for="Navn" class="form-label">Navn <span class="valgfritt">(valgfritt)</span></label>
                    <input asp-for="Navn" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Navn"></span>
                </div>
                <div class="felt">
                    <label asp-for="Telefon" class="form-label">Telefon <span class="valgfritt">(valgfritt)</span></label>
                    <input asp-for="Telefon" class="form-control" type="tel" autocomplete="tel" />
                    <span asp-validation-for="Telefon"></span>
                </div>
            </div>
        </fieldset>

        <div class="skjema-bunn">
            <button type="submit" class="btn btn-success btn-lg">Send inn</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Avbryt</a>
        </div>
    </form>

    <aside class="sidepanel" aria-labelledby="panel-tittel">
        <h2 id="panel-tittel">Hva skjer videre?</h2>
        <ol>
            <li>Ressursen får status «Tilgjengelig».</li>
            <li>Den vises på kartet til kriseledelsen.</li>
            <li>Kriseledelsen kan koble den til et behov i nærheten.</li>
        </ol>
        <p>Trenger du selv hjelp? <a asp-controller="Behov" asp-action="Opprett">Meld et behov</a>.</p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/kart.js" asp-append-version="true"></script>
}
