@model Nabohjelp.ViewModels.TildelingViewModel

@{
    ViewData["Title"] = T["Tildeling fullført"];

    // Resultatet inneholder ressursen som ble tildelt.
    MatchendeRessursViewModel? ressurs = null;
    if (Model.MatchendeRessurser.Count > 0)
    {
        ressurs = Model.MatchendeRessurser[0];
    }
}

<div class="side-topp">
    <h1>@T["Tildeling fullført"]</h1>
</div>

<div class="alert alert-success">
    @T["Ressursen er tildelt behovet."]
</div>

<!-- Informasjon om behovet -->
<div class="card mb-3">
    <div class="card-body">

        <h2 class="h5">
            @T["Behov #{0}", Model.BehovId]
        </h2>

        <p>
            <strong>@T["Behovstype:"]</strong>
            @Visningstekst.Type(Model.BehovType, Model.AnnetType)
        </p>

        <p>
            <strong>@T["Status:"]</strong>
            @Visningstekst.Status(Model.Status)
        </p>

        <p>
            <strong>@T["Posisjon:"]</strong>
            @Model.Latitude, @Model.Longitude
        </p>

    </div>
</div>

@if (ressurs != null)
{
    <!-- Informasjon om den tildelte ressursen -->
    <div class="card mb-3">
        <div class="card-body">

            <h2 class="h5">
                @T["Tildelt ressurs"]
            </h2>

            <p>
                <strong>@T["Type:"]</strong>
                @Visningstekst.RessursType(ressurs.Type, ressurs.AnnetType)
            </p>

            <p>
                <strong>@T["Posisjon:"]</strong>
                @ressurs.Posisjon
            </p>

            <p>
                <strong>@T["Status:"]</strong>
                @T[ressurs.Status]
            </p>

            <p>
                <strong>@T["Match:"]</strong>
                @ressurs.MatchBegrunnelse
            </p>

        </div>
    </div>
}

<div class="d-flex gap-3 flex-wrap">
    <!-- Tilbake til tildelingsoversikten -->
    <a asp-controller="Tildeling"
       asp-action="Index"
       class="btn btn-primary">
        @T["Tilbake til tildeling"]
    </a>

    @* Valgte du feil ressurs? Da kan tildelingen angres med en gang (TildelingController.Angre).
       Etterpå kommer du tilbake til matchingen for samme behov og kan velge en annen. *@
    @if (Model.TildelingId != 0)
    {
        <form asp-controller="Tildeling" asp-action="Angre" method="post"
              onsubmit="return confirm('@T["Vil du angre tildelingen? Ressursen blir tilgjengelig igjen."]');">
            <input type="hidden" name="id" value="@Model.TildelingId" />
            <input type="hidden" name="tilbake" value="@Url.Action("Match", "Tildeling", new { id = Model.BehovId })" />
            <button type="submit" class="btn btn-outline-secondary">@T["Angre tildeling"]</button>
        </form>
    }
</div>