@model Nabohjelp.ViewModels.TildelingViewModel
@using System.Globalization

@{
    ViewData["Title"] = T["Match ressurs"];

    // Koordinatene skrives med punktum, slik kartet (kart.js) forventer.
    string bredde = Model.Latitude.ToString(CultureInfo.InvariantCulture);
    string lengde = Model.Longitude.ToString(CultureInfo.InvariantCulture);
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
}

<div class="side-topp">
    <h1>@T["Match ressurs"]</h1>
    <p class="ingress">@T["Velg en ressurs som passer til behovet."]</p>
</div>

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

<!-- Informasjon om behovet -->
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">@T["Behov #{0}", Model.BehovId]</h2>
        <p><strong>@T["Type:"]</strong> @Visningstekst.Type(Model.BehovType, Model.AnnetType)</p>
        <p><strong>@T["Prioritet:"]</strong> @Visningstekst.Prioritet(Model.Prioritet)</p>
        <p><strong>@T["Status:"]</strong> @Visningstekst.Status(Model.Status)</p>
        <p>
            <strong>@T["Beskrivelse:"]</strong>
            <span class="tekst-linjer">@(string.IsNullOrWhiteSpace(Model.Beskrivelse) ? T["Ingen beskrivelse"].Value : Model.Beskrivelse)</span>
        </p>
    </div>
</div>

<!-- Kart over behovets posisjon (tegnes av kart.js) -->
<h2 class="h4">@T["Posisjon"]</h2>
<div class="kart-boks mb-2"
     data-kartvisning
     data-bredde="@bredde"
     data-lengde="@lengde"
     data-nal="hjelp"
     role="img"
     aria-label="@T["Kart som viser hvor behovet er"]"></div>
<p>@bredde, @lengde</p>

<hr />

<h2 class="h4">@T["Matchende ressurser"]</h2>
<p class="text-muted">@T["Nærmeste ressurs vises først. Avstanden er luftlinje, ikke kjøreavstand."]</p>

@if (Model.MatchendeRessurser.Count == 0)
{
    <div class="alert alert-warning">@T["Ingen tilgjengelige ressurser matcher dette behovet."]</div>
}
else
{
    @if (Model.Status == BehovStatus.Assigned)
    {
        <div class="alert alert-info">
            @T["Dette behovet har allerede fått minst én ressurs. Du kan tildele flere hvis det trengs."]
        </div>
    }

    <!-- Filteret skjuler kort som ligger lenger unna enn valgt avstand (se skriptet nederst). -->
    <div class="mb-3">
        <label for="avstandsfilter" class="form-label"><strong>@T["Filtrer etter avstand:"]</strong></label>
        <select id="avstandsfilter" class="form-select" style="max-width: 250px;">
            <option value="alle">@T["Alle avstander"]</option>
            <option value="10">@T["Innenfor 10 km"]</option>
            <option value="25">@T["Innenfor 25 km"]</option>
            <option value="50">@T["Innenfor 50 km"]</option>
            <option value="100">@T["Innenfor 100 km"]</option>
        </select>
    </div>

    <p id="ingenInnenforAvstand" class="alert alert-warning" hidden>
        @T["Ingen ressurser finnes innenfor valgt avstand."]
    </p>

    <div class="row">
        @foreach (var ressurs in Model.MatchendeRessurser)
        {
            // Tom avstand betyr at ressursen mangler posisjon.
            string avstand = "";
            if (ressurs.AvstandKm != null)
            {
                avstand = ressurs.AvstandKm.Value.ToString(CultureInfo.InvariantCulture);
            }

            <div class="col-12 col-md-6 mb-3 ressurs-kort" data-avstand="@avstand">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">
                            @Visningstekst.RessursType(ressurs.Type, ressurs.AnnetType)
                            @if (ressurs.ErAnbefalt)
                            {
                                <span class="badge bg-success ms-2">@T["Anbefalt"]</span>
                            }
                        </h3>

                        <p><strong>@T["Posisjon:"]</strong> @ressurs.Posisjon</p>
                        <p><strong>@T["Avstand:"]</strong> @(ressurs.AvstandKm.HasValue ? ressurs.AvstandKm.Value.ToString("F1") + " km" : T["Avstand ukjent"].Value)</p>
                        <p><strong>@T["Status:"]</strong> @T[ressurs.Status]</p>
                        <p><strong>@T["Navn:"]</strong> @(string.IsNullOrWhiteSpace(ressurs.Navn) ? T["Ikke oppgitt"].Value : ressurs.Navn)</p>
                        <p><strong>@T["Match:"]</strong> @ressurs.MatchBegrunnelse</p>

                        <form asp-action="Tildel" method="post">
                            <input type="hidden" name="behovId" value="@Model.BehovId" />
                            <input type="hidden" name="ressursId" value="@ressurs.RessursId" />
                            <button type="submit" class="btn btn-success">@T["Tildel ressurs"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary mt-3">@T["Tilbake"]</a>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
    <script src="~/js/kart.js" asp-append-version="true"></script>
    <script>
        // Avstandsfilter: viser bare kortene som ligger innenfor valgt avstand.
        const filter = document.getElementById('avstandsfilter');
        const kortene = document.querySelectorAll('.ressurs-kort');
        const ingenTreff = document.getElementById('ingenInnenforAvstand');

        if (filter) {
            filter.addEventListener('change', function () {
                let antallSynlige = 0;

                kortene.forEach(function (kort) {
                    const avstand = kort.dataset.avstand;
                    const vis = filter.value === 'alle' ||
                        (avstand !== '' && Number(avstand) <= Number(filter.value));

                    kort.hidden = !vis;
                    if (vis) {
                        antallSynlige++;
                    }
                });

                ingenTreff.hidden = antallSynlige > 0;
            });
        }
    </script>
}
