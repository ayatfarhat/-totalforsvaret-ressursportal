@model List<Behov>
@* Første steg i tildelingen: behovene som kan få en ressurs. «Finn ressurs» går videre
   til Match.cshtml for det valgte behovet. *@

@{
    ViewData["Title"] = T["Tildeling"];
}

<div class="side-topp">
    <h1>@T["Tildeling og matching"]</h1>
    <p class="ingress">@T["Velg et behov for å finne tilgjengelige ressurser som passer."]</p>
</div>

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

@if (Model.Count == 0)
{
    <!-- Vises når det ikke finnes aktive behov -->
    <div class="alert alert-info">
        @T["Det finnes ingen aktive behov som kan tildeles."]
    </div>
}
else
{
    <div class="liste-topp">
        <h2>@T["Aktive behov"]</h2>
        <span class="antall">@Model.Count</span>
    </div>

    <!-- På mobil blir hver rad et lite kort (klassen «stablet») -->
    <div class="table-responsive">
        <table class="table stablet align-middle">

            <thead>
                <tr>
                    <th scope="col">@T["Nr."]</th>
                    <th scope="col">@T["Behov"]</th>
                    <th scope="col">@T["Prioritet"]</th>
                    <th scope="col">@T["Status"]</th>
                    <th scope="col">@T["Beskrivelse"]</th>
                    <th scope="col"><span class="visually-hidden">@T["Handling"]</span></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var behov in Model)
                {
                    <tr class="@(behov.Prioritet == BehovPrioritet.Urgent ? "rad-akutt" : "")">
                        <td data-label="@T["Nr."]">@behov.Id</td>
                        <td data-label="@T["Behov"]"><strong>@Visningstekst.Type(behov.Type, behov.AnnetType)</strong></td>
                        <td data-label="@T["Prioritet"]">
                            <span class="merke @Visningstekst.PrioritetFarge(behov.Prioritet)">@Visningstekst.Prioritet(behov.Prioritet)</span>
                        </td>
                        <td data-label="@T["Status"]">
                            <span class="merke @Visningstekst.StatusFarge(behov.Status)">@Visningstekst.Status(behov.Status)</span>
                        </td>

                        <td data-label="@T["Beskrivelse"]">
                            <span class="tekst-linjer">@(string.IsNullOrWhiteSpace(behov.Beskrivelse)
                                ? T["Ingen beskrivelse"].Value
                                : behov.Beskrivelse)</span>
                        </td>

                        <td data-label="">
                            <!-- Åpner matching for dette behovet -->
                            <a asp-controller="Tildeling"
                               asp-action="Match"
                               asp-route-id="@behov.Id"
                               class="btn btn-primary btn-sm">
                                @T["Finn ressurs"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}