@model IEnumerable<Behov>

@{
    ViewData["Title"] = "Tildeling";
}

<div class="side-topp">
    <h1>Tildeling og matching</h1>
    <p class="ingress">Velg et behov for å finne tilgjengelige ressurser som passer.</p>
</div>

@if (TempData["Feil"] is string feil)
{
    <div class="alert alert-danger" role="alert">@feil</div>
}

@if (!Model.Any())
{
    <!-- Vises når det ikke finnes aktive behov -->
    <div class="alert alert-info">
        Det finnes ingen aktive behov som kan tildeles.
    </div>
}
else
{
    <div class="liste-topp">
        <h2>Aktive behov</h2>
        <span class="antall">@Model.Count()</span>
    </div>

    <!-- På mobil blir hver rad et lite kort (klassen «stablet») -->
    <div class="table-responsive">
        <table class="table stablet align-middle">

            <thead>
                <tr>
                    <th scope="col">Nr.</th>
                    <th scope="col">Behov</th>
                    <th scope="col">Prioritet</th>
                    <th scope="col">Status</th>
                    <th scope="col">Beskrivelse</th>
                    <th scope="col"><span class="visually-hidden">Handling</span></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var behov in Model)
                {
                    <tr class="@(behov.Prioritet == BehovPrioritet.Urgent ? "rad-akutt" : "")">
                        <td data-label="Nr.">@behov.Id</td>
                        <td data-label="Behov"><strong>@Visningstekst.Type(behov.Type, behov.AnnetType)</strong></td>
                        <td data-label="Prioritet">
                            <span class="merke @(behov.Prioritet == BehovPrioritet.Urgent ? "merke-hjelp" : "")">@Visningstekst.Prioritet(behov.Prioritet)</span>
                        </td>
                        <td data-label="Status">
                            <span class="merke @Visningstekst.StatusFarge(behov.Status)">@Visningstekst.Status(behov.Status)</span>
                        </td>

                        <td data-label="Beskrivelse">
                            <span class="tekst-linjer">@(string.IsNullOrWhiteSpace(behov.Beskrivelse)
                                ? "Ingen beskrivelse"
                                : behov.Beskrivelse)</span>
                        </td>

                        <td data-label="">
                            <!-- Åpner matching for dette behovet -->
                            <a asp-controller="Tildeling"
                               asp-action="Match"
                               asp-route-id="@behov.Id"
                               class="btn btn-primary btn-sm">
                                Finn ressurs
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}