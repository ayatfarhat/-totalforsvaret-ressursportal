@model IEnumerable<Nabohjelp.Models.Behov>

@{
    ViewData["Title"] = "Tildeling";
}

<div class="sidetopp">
    <h1>Tildeling</h1>
    <p class="ingress">Velg et behov for å se hvilke tilgjengelige ressurser som passer.</p>
</div>

@if (!Model.Any())
{
    <!-- Vises når det ikke finnes aktive behov -->
    <div class="tom-liste">
        <p>Det finnes ingen aktive behov som kan tildeles.</p>
    </div>
}
else
{
    <div class="tabell-ramme">
        <table class="tabell">
            <thead>
                <tr>
                    <th>Nr.</th>
                    <th>Behov</th>
                    <th>Prioritet</th>
                    <th>Status</th>
                    <th>Beskrivelse</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var behov in Model)
                {
                    <tr class="@Visningstekst.RadKlasse(behov.Prioritet)">
                        <td>@behov.Id</td>
                        <td class="sterk">@Visningstekst.Type(behov.Type)</td>
                        <td><span class="merke @Visningstekst.PrioritetFarge(behov.Prioritet)">@Visningstekst.Prioritet(behov.Prioritet)</span></td>
                        <td><span class="merke @Visningstekst.StatusFarge(behov.Status)">@Visningstekst.Status(behov.Status)</span></td>
                        <td class="lang-tekst">
                            @if (string.IsNullOrWhiteSpace(behov.Beskrivelse))
                            {
                                <span>Ingen beskrivelse</span>
                            }
                            else
                            {
                                @behov.Beskrivelse
                            }
                        </td>
                        <td class="hoyre">
                            <!-- Åpner matching for dette behovet -->
                            <a asp-controller="Tildeling"
                               asp-action="Match"
                               asp-route-id="@behov.Id"
                               class="btn btn-primary btn-sm">
                                Finn ressurs
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
